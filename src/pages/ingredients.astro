---
import BaseLayout from '@/layouts/BaseLayout'
import IngredientsIndex from '@/components/IngredientsIndex'

const description =
	'Catalogue des préparations du site — fonds, biscuits, croustillants, inserts, mousses… Filtrer par mot-clé, par saveur ou par type.'
---

<BaseLayout title='Préparations' description={description} gradient>
	<article class='min-w-full md:py-4'>
		<header class='flex flex-col gap-4'>
			<span class='pop-chip pop-chip--mint w-fit'>Catalogue</span>
			<h1 class='pop-display text-4xl sm:text-5xl md:text-6xl'>Les préparations</h1>
			<p class='max-w-2xl text-base leading-relaxed text-ink/70 dark:text-ink-body'>
				Toutes les préparations du site : fonds, biscuits, croustillants, inserts, mousses… Filtrez
				par mot-clé, par saveur ou par type pour assembler une nouvelle création.
			</p>
		</header>

		<hr class='pop-rule my-8 md:my-10' />

		<IngredientsIndex />
	</article>
</BaseLayout>
