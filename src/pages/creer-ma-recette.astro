---
import { getCollection } from 'astro:content'
import BaseLayout from '@/layouts/BaseLayout'
import RecipeSlotSelect from '@/components/RecipeSlotSelect'
import ingredientFlavors from '../../ingredients-flavors.json'
import {
	RECIPE_KINDS,
	RECIPE_KIND_ORDER,
	optionSlots,
	primarySlots,
	requiredSlotKeys,
	type RecipeSlot
} from '../utils/recipeSlots'

// Charge tous les éléments modulaires et range-les par catégorie.
const allIngredients = await getCollection('recipeIngredients')

type BuilderIngredient = {
	id: string
	name: string
	category: string
	description: string | null
	source: { title: string; url: string } | string | null
	ingredients: { item: string; quantity: string | null }[]
	steps: string[]
	flavor: string[]
}

const components: BuilderIngredient[] = allIngredients.map((ingredient) => ({
	id: ingredient.id,
	name: ingredient.data.name,
	category: ingredient.data.category,
	description: ingredient.data.description ?? null,
	source: ingredient.data.source ?? null,
	ingredients: ingredient.data.ingredients.map((i) => ({
		item: i.item,
		quantity: i.quantity ?? null
	})),
	steps: ingredient.data.steps,
	flavor: ingredient.data.flavor
}))

// Saveurs associées (ingredients-flavors.json) : chaque saveur y liste les
// saveurs recommandées avec elle. Deux couches sont donc « liées » dès qu'une
// saveur de l'une figure dans la liste d'une saveur de l'autre.
const companionFlavors = new Map(
	ingredientFlavors.map((entry) => [entry.flavor, new Set(entry.compatibles)])
)

const flavorsAreLinked = (left: string[], right: string[]) =>
	left.some((a) =>
		right.some(
			(b) => a !== b && (companionFlavors.get(a)?.has(b) || companionFlavors.get(b)?.has(a))
		)
	)

// Les quatre couches « modulaires » d'un montage : chacune répond aux trois
// autres. Une option porte le badge « Recommandé » quand une de ses saveurs est
// associée à celle de *chaque* autre couche déjà choisie (voir le script client).
const PAIRED_CATEGORIES = ['biscuit', 'croustillant', 'insert', 'mousse']
const companionIds: Record<string, string[]> = {}
for (const component of components) {
	if (!PAIRED_CATEGORIES.includes(component.category)) continue
	companionIds[component.id] = components
		.filter((other) => other.id !== component.id)
		.filter((other) => PAIRED_CATEGORIES.includes(other.category))
		.filter((other) => flavorsAreLinked(component.flavor, other.flavor))
		.map((other) => other.id)
}

const optionsByCategory: Record<string, BuilderIngredient[]> = {}
for (const component of components) {
	;(optionsByCategory[component.category] ??= []).push(component)
}

// Un même nom peut exister en plusieurs variantes : on n'en garde qu'une par nom
// pour ne pas noyer les menus déroulants, en préférant la plus complète.
for (const category of Object.keys(optionsByCategory)) {
	const byName = new Map<string, BuilderIngredient>()
	for (const component of optionsByCategory[category]) {
		const name = component.name.trim().toLowerCase()
		const current = byName.get(name)
		if (!current || component.ingredients.length > current.ingredients.length) {
			byName.set(name, component)
		}
	}
	optionsByCategory[category] = [...byName.values()].sort((a, b) =>
		a.name.localeCompare(b.name, 'fr')
	)
}

const optionsFor = (slot: RecipeSlot) => optionsByCategory[slot.category] ?? []

// Le script client a besoin de l'ordre des couches et des slots obligatoires.
const kindConfig = Object.fromEntries(
	RECIPE_KINDS.map((kind) => [
		kind.key,
		{
			label: kind.label,
			order: RECIPE_KIND_ORDER[kind.key],
			required: requiredSlotKeys(kind.key)
		}
	])
)
---

<BaseLayout title='Créer ma recette' gradient>
	<article class='min-w-full md:py-4 sm:max-w-none md:max-w-none'>
		<header class='mb-3 flex flex-col justify-center items-center gap-6'>
			<div class='flex flex-col gap-2'>
				<h1 class='text-center text-4xl md:text-6xl md:pb-2.5 font-semibold'>Créer ma recette</h1>
				<p class='text-center text-slate-600 dark:text-ink-muted'>
					Choisissez le type de recette, puis un élément dans chaque catégorie : ils s'assemblent
					pour former une nouvelle recette.
				</p>
			</div>
		</header>

		<hr />

		<!-- Carte du haut : le type de recette, puis les menus déroulants.
		     `relative z-40` : la carte crée son propre contexte d'empilement (le
		     verre dépoli des cartes de fond de page passe par backdrop-filter), donc
		     sans ce niveau les listes ouvertes dans les rangées du bas passeraient
		     *sous* le sommaire et la recette, qui les suivent dans le document. -->
		<section
			class='relative z-40 frost-surface bg-white dark:bg-ink-surface rounded-2xl border border-slate-200 dark:border-ink-line p-6 md:p-8 shadow-sm dark:shadow-none'
		>
			<div class='flex flex-wrap items-center justify-between gap-4 mb-6'>
				<h2 class='text-2xl font-semibold text-primary'>Composez votre recette</h2>
				<button
					id='builder-reset'
					type='button'
					class='px-4 py-2 rounded-lg border border-slate-300 dark:border-ink-line text-sm font-medium hover:bg-slate-100 dark:hover:bg-ink-raised transition'
				>
					Réinitialiser
				</button>
			</div>

			<label class='flex flex-col gap-2 max-w-xs'>
				<span class='font-semibold text-primary'>Type de recette</span>
				<div class='relative'>
					<select
						id='builder-kind'
						class='w-full appearance-none rounded-lg border border-slate-300 dark:border-ink-line bg-white dark:bg-ink-surface text-slate-900 dark:text-ink-text px-3 py-2 pr-9 text-base focus:outline-none focus:ring-2 focus:ring-primary'
					>
						<option value=''>Pas de sélection</option>
						{RECIPE_KINDS.map((kind) => <option value={kind.key}>{kind.label}</option>)}
					</select>
					<svg
						class='pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 w-4 h-4 text-slate-500 dark:text-ink-muted'
						fill='none'
						stroke='currentColor'
						viewBox='0 0 24 24'
					>
						<path stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M19 9l-7 7-7-7'
						></path>
					</svg>
				</div>
				<span class='text-xs text-slate-500 dark:text-ink-faint'>
					Le type détermine les couches nécessaires à la recette.
				</span>
			</label>

			{
				RECIPE_KINDS.map((kind) => (
					<div data-kind-block={kind.key} hidden class='mt-6'>
						<div class='grid gap-4 md:grid-cols-2 lg:grid-cols-4'>
							{primarySlots(kind.key).map((slot) => (
								<RecipeSlotSelect
									kind={kind.key}
									slot={slot}
									options={optionsFor(slot)}
									showOptionalBadge
								/>
							))}
						</div>

						{optionSlots(kind.key).length > 0 && (
							<div class='mt-6 rounded-xl border border-dashed border-slate-300 dark:border-ink-line bg-slate-50/60 dark:bg-ink-raised/40 p-4 md:p-5'>
								<div class='flex flex-wrap items-baseline gap-x-3 gap-y-1 mb-4'>
									<p class='text-sm font-semibold uppercase tracking-wide text-slate-500 dark:text-ink-muted'>
										Options
									</p>
									<span class='text-xs text-slate-500 dark:text-ink-faint'>
										Ces couches s'ajoutent dans l'ordre du montage.
									</span>
								</div>
								<div class='grid gap-4 md:grid-cols-2 lg:grid-cols-4'>
									{optionSlots(kind.key).map((slot) => (
										<RecipeSlotSelect kind={kind.key} slot={slot} options={optionsFor(slot)} />
									))}
								</div>
							</div>
						)}
					</div>
				))
			}

			<p
				id='builder-status'
				class='text-sm text-slate-500 dark:text-ink-muted mt-5'
				aria-live='polite'
			>
			</p>
		</section>

		<!-- Grille : sommaire à gauche, recette à droite -->
		<div class='grid grid-cols-1 md:grid-cols-[280px_1fr] gap-8 mt-8'>
			<aside class='md:flex flex-col gap-8 hidden'>
				<div class='sticky top-24 self-start transition-all duration-200'>
					<div
						class='frost-surface bg-gradient-to-br from-slate-50 to-slate-100 dark:bg-none dark:bg-ink-surface rounded-2xl border border-slate-200 dark:border-ink-line p-6 shadow-sm dark:shadow-none hover:shadow-md dark:hover:shadow-none transition-shadow'
					>
						<nav class='w-full'>
							<p class='font-bold mb-6 text-2xl text-primary dark:text-primary'>
								Table des matières
							</p>
							<ul id='builder-toc' class='[text-wrap:balance] flex flex-col gap-1'>
								<li class='text-slate-500 dark:text-ink-muted text-sm italic'>
									Aucun élément sélectionné
								</li>
							</ul>
						</nav>
					</div>
				</div>
			</aside>

			<article
				class='frost-surface max-w-full w-full bg-white dark:bg-ink-surface rounded-2xl border border-slate-200 dark:border-ink-line p-8 md:p-12 shadow-sm dark:shadow-none'
			>
				<div id='composed'>
					<p class='text-slate-500 dark:text-ink-muted italic'>
						Choisissez d'abord le type de recette, puis ses éléments : la recette apparaîtra ici.
					</p>
				</div>
			</article>
		</div>
	</article>

	<script define:vars={{ components, kindConfig, companionIds }}>
		const kindSelect = document.getElementById('builder-kind')
		const output = document.getElementById('composed')
		const tocEl = document.getElementById('builder-toc')
		const statusEl = document.getElementById('builder-status')

		const blocks = {}
		for (const block of document.querySelectorAll('[data-kind-block]')) {
			blocks[block.getAttribute('data-kind-block') || ''] = block
		}

		// --- Menus déroulants avec recherche (autocomplétion) ------------------
		// Le champ texte filtre la liste de sa propre boîte ; la valeur retenue
		// reste dans l'<input type=hidden data-slot>, donc la suite de la page
		// (render, réinitialisation) continue de lire `.value` comme avant.
		const withoutAccents = (value) =>
			value
				.normalize('NFD')
				.replace(/[\u0300-\u036f]/g, '')
				.toLowerCase()

		const ACTIVE_OPTION_CLASSES = ['bg-slate-100', 'dark:bg-ink-raised']

		const setupCombobox = (root) => {
			const input = root.querySelector('[data-combobox-input]')
			const hidden = root.querySelector('input[type="hidden"][data-slot]')
			const list = root.querySelector('[role="listbox"]')
			const empty = root.querySelector('[data-combobox-empty]')
			const chevron = root.querySelector('[data-combobox-chevron]')
			if (!input || !hidden || !list) return null

			const options = () => [...list.querySelectorAll('[role="option"]')]
			const visibleOptions = () => options().filter((option) => !option.hidden)
			const labelOf = (option) => option.getAttribute('data-label') || ''
			const selectedOption = () =>
				options().find((option) => option.getAttribute('data-value') === hidden.value)

			let open = false
			let active = null

			// Texte affiché dans le champ : le nom choisi, ou rien (le placeholder
			// reprend alors sa place) quand aucune couche n'est sélectionnée.
			const displayText = () => {
				const chosen = selectedOption()
				return hidden.value && chosen ? labelOf(chosen) : ''
			}

			// L'option surlignée peut être hors du cadre quand la liste est longue :
			// on ne fait défiler que la liste, jamais la page.
			const revealActive = () => {
				if (!open || !active || list.hidden || !list.clientHeight) return
				const top = active.offsetTop
				const bottom = top + active.offsetHeight
				if (top < list.scrollTop) {
					list.scrollTop = top - 4
				} else if (bottom > list.scrollTop + list.clientHeight) {
					list.scrollTop = bottom - list.clientHeight + 4
				}
			}

			const paintActive = (option) => {
				active = option || null
				for (const item of options()) {
					for (const className of ACTIVE_OPTION_CLASSES) {
						item.classList.toggle(className, item === active)
					}
				}
				if (active) {
					input.setAttribute('aria-activedescendant', active.id)
				} else {
					input.removeAttribute('aria-activedescendant')
				}
				revealActive()
			}

			// Ouvre vers le haut quand la place manque en dessous, sinon la liste
			// s'affiche sous la ligne de flottaison.
			const positionPopup = () => {
				const field = root.getBoundingClientRect()
				const below = window.innerHeight - field.bottom
				const flip = below < 264 && field.top > below
				for (const popup of [list, empty]) {
					if (!popup) continue
					popup.style.top = flip ? 'auto' : '100%'
					popup.style.bottom = flip ? '100%' : 'auto'
					popup.style.marginTop = flip ? '0' : '0.25rem'
					popup.style.marginBottom = flip ? '0.25rem' : '0'
				}
			}

			const paintOpen = () => {
				const matches = visibleOptions().length
				list.hidden = !open || matches === 0
				if (empty) empty.hidden = !open || matches > 0
				input.setAttribute('aria-expanded', String(open))
				chevron?.classList.toggle('rotate-180', open)
				revealActive()
			}

			// Filtre insensible à la casse et aux accents (« creme » trouve « Crème »).
			const filter = (query) => {
				const needle = withoutAccents(query.trim())
				for (const option of options()) {
					option.hidden = needle ? !withoutAccents(labelOf(option)).includes(needle) : false
				}
			}

			const openList = ({ showAll = false } = {}) => {
				open = true
				// Rouvrir en gardant la valeur affichée dans le champ ne montrerait que
				// cette valeur : on repart de la liste complète.
				filter(showAll ? '' : input.value)
				const chosen = selectedOption()
				paintActive(chosen && !chosen.hidden ? chosen : visibleOptions()[0] || null)
				positionPopup()
				paintOpen()
			}

			const closeList = () => {
				open = false
				paintActive(null)
				paintOpen()
				input.value = displayText()
			}

			const commit = (option) => {
				if (!option) return
				hidden.value = option.getAttribute('data-value') || ''
				for (const item of options()) {
					item.setAttribute('aria-selected', String(item === option && hidden.value !== ''))
				}
				closeList()
				hidden.dispatchEvent(new Event('change', { bubbles: true }))
			}

			// La liste ne s'ouvre ni au focus ni au passage au clavier (Tab), pour ne
			// pas masquer les champs voisins : clic, saisie ou flèche l'ouvrent.
			input.addEventListener('click', () => {
				if (open) return
				// Sélectionner le texte affiché : taper remplace la valeur en cours.
				if (input.value) input.select()
				openList({ showAll: true })
			})

			input.addEventListener('input', () => {
				open = true
				filter(input.value)
				paintActive(visibleOptions()[0] || null)
				paintOpen()
			})

			input.addEventListener('keydown', (event) => {
				const matches = visibleOptions()
				if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
					event.preventDefault()
					if (!open) {
						openList({ showAll: true })
						return
					}
					if (!matches.length) return
					const index = matches.indexOf(active)
					const next =
						event.key === 'ArrowDown'
							? matches[Math.min(index + 1, matches.length - 1)]
							: matches[Math.max(index - 1, 0)]
					paintActive(next)
				} else if (event.key === 'Enter') {
					if (!open) return
					event.preventDefault()
					// Entrée retient la proposition surlignée, sinon la seule restante.
					commit(active || matches[0] || null)
				} else if (event.key === 'Escape') {
					if (!open) return
					event.preventDefault()
					closeList()
				} else if (event.key === 'Tab') {
					closeList()
				} else if (
					!open &&
					event.key.length === 1 &&
					!event.ctrlKey &&
					!event.metaKey &&
					!event.altKey
				) {
					// Première frappe dans un champ déjà rempli : elle remplace la valeur
					// affichée au lieu de s'y insérer au milieu.
					input.select()
				}
			})

			// Quitter le champ annule une recherche restée sans choix : la valeur
			// affichée redevient celle réellement sélectionnée.
			input.addEventListener('blur', () => closeList())

			list.addEventListener('mousedown', (event) => {
				// Garder le focus dans le champ, sinon le blur fermerait la liste avant
				// que le clic n'ait pu retenir l'option.
				if (event.target.closest('[role="option"]')) event.preventDefault()
			})

			list.addEventListener('click', (event) => {
				commit(event.target.closest('[role="option"]'))
			})

			return {
				reset: () => {
					hidden.value = ''
					input.value = ''
					filter('')
					for (const item of options()) item.setAttribute('aria-selected', 'false')
					closeList()
				}
			}
		}

		const comboboxes = []
		for (const root of document.querySelectorAll('[data-combobox]')) {
			const combobox = setupCombobox(root)
			if (combobox) comboboxes.push(combobox)
		}

		if (kindSelect && output && tocEl) {
			const byId = new Map(components.map((component) => [component.id, component]))

			const escape = (value) =>
				String(value).replace(/[&<>"']/g, (c) => {
					switch (c) {
						case '&':
							return '&amp;'
						case '<':
							return '&lt;'
						case '>':
							return '&gt;'
						case '"':
							return '&quot;'
						default:
							return '&#39;'
					}
				})

			const sourceHtml = (source) => {
				if (!source) return ''
				if (typeof source === 'string') {
					return `<p class='text-sm text-slate-600 dark:text-ink-muted italic mb-3'>Basé sur la recette de ${escape(source)}</p>`
				}
				return `<p class='text-sm text-slate-600 dark:text-ink-muted italic mb-3'>Basé sur la recette de <a href='${escape(source.url)}' target='_blank' rel='noopener noreferrer' class='text-primary hover:underline font-medium'>${escape(source.title)}</a></p>`
			}

			// Reprend la structure de RecipeIngredientsDisplay : un bloc par élément,
			// avec le titre ancré sur `ingredient-<id>` pour que le sommaire fonctionne.
			const componentHtml = (component) => {
				const ingredients = component.ingredients.length
					? component.ingredients
							.map(
								(ing) =>
									`<li class='text-slate-700 dark:text-ink-body text-base'><span class='text-primary font-light'>– </span>${escape(ing.item)}${
										ing.quantity
											? ` <span class='text-slate-500 dark:text-ink-faint text-sm'>(${escape(ing.quantity)})</span>`
											: ''
									}</li>`
							)
							.join('')
					: `<li class='text-slate-500'>Aucun ingrédient</li>`

				const steps = component.steps.length
					? component.steps
							.map(
								(step, idx) =>
									`<li class='text-slate-700 dark:text-ink-body text-base'><span class='font-semibold text-primary'>${idx + 1}. </span>${escape(step)}</li>`
							)
							.join('')
					: `<li class='text-slate-500'>Aucune étape</li>`

				return `
					<div class='pb-8 last:pb-0'>
						<h3 id='ingredient-${escape(component.id)}' class='text-2xl font-semibold mb-2 text-primary'>${escape(component.name)}</h3>
						${sourceHtml(component.source)}
						${component.description ? `<p class='text-slate-700 dark:text-ink-body text-base mb-4'>${escape(component.description)}</p>` : ''}
						<div class='grid grid-cols-1 md:grid-cols-2 gap-8'>
							<div>
								<h4 class='font-semibold text-base text-primary uppercase tracking-wide mb-4'>Ingrédients</h4>
								<ul class='space-y-3'>${ingredients}</ul>
							</div>
							<div>
								<h4 class='font-semibold text-base text-primary uppercase tracking-wide mb-4'>Étapes</h4>
								<ol class='space-y-3'>${steps}</ol>
							</div>
						</div>
					</div>`
			}

			const tocHeadingHtml = (text, slug, depth) =>
				depth === 2
					? `<a href='#${slug}' class='font-semibold text-base text-slate-900 dark:text-ink-text hover:text-primary py-2 px-0 transition-colors'>${escape(text)}</a>`
					: `<a href='#${slug}' class='text-base text-slate-600 dark:text-ink-muted hover:text-primary py-1.5 px-0 transition-colors ml-2'>${escape(text)}</a>`

			const renderToc = (chosen) => {
				if (!chosen.length) {
					tocEl.innerHTML = `<li class='text-slate-500 dark:text-ink-muted text-sm italic'>Aucun élément sélectionné</li>`
					return
				}
				tocEl.innerHTML = `
					<li class='flex flex-col mb-2'>${tocHeadingHtml('Montage', 'montage', 2)}</li>
					<li class='flex flex-col mb-2'>
						${tocHeadingHtml('Recette', 'recette', 2)}
						<ul class='flex flex-col'>
							${chosen.map((component) => `<li class='flex flex-col mb-2'>${tocHeadingHtml(component.name, `ingredient-${component.id}`, 3)}</li>`).join('')}
						</ul>
					</li>`
			}

			// Le champ caché du menu déroulant : c'est lui qui porte la valeur.
			const slotSelect = (kind, key) => blocks[kind]?.querySelector(`[data-slot="${key}"]`) ?? null

			// Recommandations biscuit / croustillant / insert / mousse : dans chacun de
			// ces menus, une option porte le badge « Recommandé » quand sa saveur est
			// associée à celle de chacune des trois autres couches déjà choisies.
			// Un menu sans autre couche remplie n'allume donc rien.
			const RECOMMENDED_SLOTS = ['biscuit', 'croustillant', 'insert', 'mousse']

			const paintRecommendations = (kind) => {
				// On repart de zéro : un type de recette sans sélection (ou une
				// réinitialisation) ne doit laisser aucun badge allumé.
				for (const badge of document.querySelectorAll('[data-rec-badge]')) badge.hidden = true
				if (!kind) return
				for (const slot of RECOMMENDED_SLOTS) {
					const field = slotSelect(kind, slot)
					const list = field?.closest('[data-combobox]')?.querySelector('[role="listbox"]')
					if (!list) continue

					// Toutes les autres couches remplies restreignent la liste : on croise
					// leurs recommandations, donc une option ne survit que si elle est
					// associée à chacune d'elles.
					const others = RECOMMENDED_SLOTS.filter((key) => key !== slot)
						.map((key) => slotSelect(kind, key)?.value)
						.filter(Boolean)

					const recommended = new Set()
					for (const [index, id] of others.entries()) {
						const links = new Set(companionIds[id] ?? [])
						if (index === 0) {
							for (const linked of links) recommended.add(linked)
							continue
						}
						for (const linked of [...recommended]) {
							if (!links.has(linked)) recommended.delete(linked)
						}
					}

					for (const option of list.querySelectorAll('[role="option"]')) {
						const badge = option.querySelector('[data-rec-badge]')
						if (badge) badge.hidden = !recommended.has(option.getAttribute('data-value') || '')
					}
				}
			}

			const placeholder = (text) =>
				`<p class='text-slate-500 dark:text-ink-muted italic'>${text}</p>`

			// Nom donné à la création : il devient le titre affiché au-dessus du
			// montage, et le titre du PDF. Tant que l'auteur ne l'a pas modifié
			// lui-même, il suit automatiquement la recette (type + saveurs).
			let recipeName = ''
			let nameEdited = false
			let nameEditing = false

			// Nom par défaut : le type de recette suivi des saveurs de l'insert puis
			// de la mousse, comme sur le blog (« Tarte fraise basilic vanille »).
			const defaultRecipeName = (kind, config) => {
				const parts = [config?.label || kind]
				for (const key of ['insert', 'mousse']) {
					const value = slotSelect(kind, key)?.value
					if (value) parts.push(...(byId.get(value)?.flavor ?? []))
				}
				return parts.filter(Boolean).join(' ').trim()
			}

			// Titre affiché au-dessus du montage : le nom de la recette, avec un bouton
			// « crayon » pour le modifier. Le champ de saisie vit juste à côté et n'est
			// révélé qu'en édition (voir renderTitleState).
			const titleBlockHtml = () => `
				<div id='builder-title' class='mb-8 flex flex-col items-start gap-3'>
					<div class='flex items-center gap-3'>
						<h2 id='recipe-title' class='text-left text-5xl font-bold leading-tight text-primary'>${escape(recipeName)}</h2>
						<button
							id='builder-name-edit'
							type='button'
							title='Modifier le nom'
							aria-label='Modifier le nom'
							class='shrink-0 rounded-lg border border-slate-300 dark:border-ink-line p-2 text-slate-500 dark:text-ink-muted transition hover:bg-slate-100 dark:hover:bg-ink-raised hover:text-primary'
						>
							<svg class='h-4 w-4' fill='none' stroke='currentColor' viewBox='0 0 24 24'>
								<path stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7'></path>
								<path stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z'></path>
							</svg>
						</button>
					</div>
					<input
						id='builder-name'
						type='text'
						value='${escape(recipeName)}'
						placeholder='Tarte framboise-basilic'
						hidden
						class='w-full max-w-xl rounded-lg border border-slate-300 dark:border-ink-line bg-white dark:bg-ink-surface px-3 py-2 text-left text-3xl font-semibold text-slate-900 dark:text-ink-text placeholder:text-slate-400 dark:placeholder:text-ink-faint focus:outline-none focus:ring-2 focus:ring-primary'
					/>
				</div>`

			// Reflète l'état d'édition dans le bloc de titre : titre affiché ou champ
			// de saisie, valeur à jour, focus placé au bon endroit.
			const renderTitleState = () => {
				const title = output.querySelector('#recipe-title')
				const editButton = output.querySelector('#builder-name-edit')
				const input = output.querySelector('#builder-name')
				if (!title || !editButton || !input) return
				title.textContent = (recipeName || '').trim() || 'Ma recette'
				input.value = recipeName
				title.hidden = nameEditing
				editButton.hidden = nameEditing
				input.hidden = !nameEditing
				if (nameEditing) {
					input.focus()
					input.select()
				}
			}

			// Bouton d'export, affiché dans la ligne du titre « Recette » une fois la
			// recette complète. Le clic est capté par le script d'export pdf plus bas.
			const downloadButton = `
				<button
					id='builder-download'
					type='button'
					class='inline-flex items-center gap-2 rounded-lg bg-primary px-4 py-2 text-sm font-medium text-white transition hover:opacity-90'
				>
					<svg class='h-4 w-4' fill='none' stroke='currentColor' viewBox='0 0 24 24'>
						<path stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M12 3v12m0 0l-4-4m4 4l4-4M5 21h14'></path>
					</svg>
					Télécharger en PDF
				</button>`

			const render = () => {
				const kind = kindSelect.value
				for (const key of Object.keys(blocks)) {
					blocks[key].hidden = key !== kind
				}

				paintRecommendations(kind)

				if (!kind) {
					renderToc([])
					if (statusEl) statusEl.textContent = ''
					output.innerHTML = placeholder(
						"Choisissez d'abord le type de recette : tarte ou entremet."
					)
					return
				}

				const config = kindConfig[kind] || { order: [], required: [] }

				// Tant que le nom n'a pas été modifié à la main, il suit la recette
				// (type + saveurs de l'insert et de la mousse).
				if (!nameEdited) recipeName = defaultRecipeName(kind, config)

				// L'ordre du montage est celui de la config, du bas du gâteau vers le haut.
				const chosen = config.order
					.map((key) => {
						const value = slotSelect(kind, key)?.value
						return value ? byId.get(value) : null
					})
					.filter(Boolean)

				const missing = config.required.filter((key) => !slotSelect(kind, key)?.value)

				renderToc(chosen)

				if (statusEl) {
					statusEl.textContent = missing.length
						? `Encore ${missing.length} élément(s) obligatoire(s) à choisir.`
						: 'Recette complète ✨'
				}

				if (!chosen.length) {
					output.innerHTML = placeholder(
						'Votre recette apparaîtra ici dès que vous sélectionnerez un élément.'
					)
					return
				}

				const montage = chosen
					.map(
						(component) =>
							`<li class='text-slate-700 dark:text-ink-body text-base pl-1'>${escape(component.name)}</li>`
					)
					.join('')

				const complete = missing.length === 0 && chosen.length > 0

				// Données structurées lues par le script d'export PDF (jsPDF).
				window.__recipePdfData = complete
					? {
							kind,
							kindLabel: config.label || kind,
							components: chosen.map((component) => ({
								name: component.name,
								description: component.description,
								source: component.source,
								ingredients: component.ingredients,
								steps: component.steps
							}))
						}
					: null

				output.innerHTML = `
					<div class='w-full'>
						${titleBlockHtml()}
						<h2 id='montage' class='text-4xl font-bold mb-8 text-primary'>Montage</h2>
						<ol class='space-y-3 list-decimal pl-5 mb-12'>${montage}</ol>
						<div class='border-t border-slate-200 dark:border-ink-line pt-8'>
							<div class='flex flex-wrap items-center justify-between gap-4 mb-8'>
								<h2 id='recette' class='text-4xl font-bold text-primary'>Recette</h2>
								${complete ? downloadButton : ''}
							</div>
							<div class='space-y-8'>${chosen.map(componentHtml).join('')}</div>
						</div>
					</div>`

				renderTitleState()
			}

			// --- Édition du nom (délégation : le bloc est réécrit à chaque rendu) ---
			output.addEventListener('click', (event) => {
				const target = event.target
				if (!(target instanceof Element) || !target.closest('#builder-name-edit')) return
				nameEditing = true
				renderTitleState()
			})

			output.addEventListener('input', (event) => {
				const target = event.target
				if (!(target instanceof HTMLInputElement) || target.id !== 'builder-name') return
				recipeName = target.value
				nameEdited = true
			})

			output.addEventListener('keydown', (event) => {
				const target = event.target
				if (!(target instanceof HTMLInputElement) || target.id !== 'builder-name') return
				if (event.key === 'Enter') {
					event.preventDefault()
					nameEditing = false
					renderTitleState()
				} else if (event.key === 'Escape') {
					nameEditing = false
					renderTitleState()
				}
			})

			// Quitter le champ vaut validation : le titre reprend la valeur saisie.
			output.addEventListener('focusout', (event) => {
				const target = event.target
				if (!(target instanceof HTMLInputElement) || target.id !== 'builder-name') return
				nameEditing = false
				renderTitleState()
			})

			for (const field of document.querySelectorAll('[data-slot]')) {
				field.addEventListener('change', render)
			}

			kindSelect.addEventListener('change', render)

			document.getElementById('builder-reset')?.addEventListener('click', () => {
				kindSelect.value = ''
				for (const combobox of comboboxes) combobox.reset()
				// Le nom fait partie de la création : il s'efface avec elle.
				recipeName = ''
				nameEdited = false
				nameEditing = false
				render()
			})

			render()
		}
	</script>

	<!-- Export PDF : génère un fichier .pdf téléchargé directement (jsPDF), mis en
	     page en texte vectoriel sélectionnable et sans la table des matières. -->
	<script>
		const MARGIN = 48
		const GUTTER = 28
		const LINE_FACTOR = 1.3
		const ITEM_GAP = 4
		const CARD_PAD = 14
		const CARD_GAP = 14
		const CARD_RADIUS = 9
		const PRIMARY = [111, 107, 174]
		const BODY = [45, 45, 55]
		const MUTED = [122, 122, 138]
		const CARD_FILL = [244, 244, 248]
		const FONT = 'helvetica'

		const sourceLabel = (source) => {
			if (!source) return ''
			if (typeof source === 'string') return `Basé sur la recette de ${source}`
			const url = source.url ? ` - ${source.url}` : ''
			return `Basé sur la recette de ${source.title}${url}`
		}

		const slugify = (value) =>
			value
				.normalize('NFD')
				.replace(/[\u0300-\u036f]/g, '')
				.toLowerCase()
				.replace(/[^a-z0-9]+/g, '-')
				.replace(/^-+|-+$/g, '')
				.slice(0, 60)

		const buildRecipePdf = (jsPDF, data) => {
			const doc = new jsPDF({ orientation: 'portrait', unit: 'pt', format: 'a4' })
			const pageW = doc.internal.pageSize.getWidth()
			const pageH = doc.internal.pageSize.getHeight()
			const contentW = pageW - MARGIN * 2
			const innerW = contentW - CARD_PAD * 2
			const colW = (innerW - GUTTER) / 2
			const bottom = pageH - 54
			doc.setLineHeightFactor(LINE_FACTOR)

			let y = MARGIN

			const applyFont = (size, style = 'normal', color = BODY) => {
				doc.setFont(FONT, style)
				doc.setFontSize(size)
				doc.setTextColor(color[0], color[1], color[2])
			}

			// Hauteur d'un texte une fois replié sur `width`.
			const heightOf = (text, width, size, style = 'normal') => {
				doc.setFont(FONT, style)
				doc.setFontSize(size)
				return doc.splitTextToSize(String(text), width).length * size * LINE_FACTOR
			}

			// Dessine un paragraphe replié depuis son bord haut et renvoie sa hauteur.
			const draw = (text, x, top, width, size, style = 'normal', color = BODY) => {
				applyFont(size, style, color)
				const lines = doc.splitTextToSize(String(text), width)
				doc.text(lines, x, top, { baseline: 'top' })
				return lines.length * size * LINE_FACTOR
			}

			const newPage = () => {
				doc.addPage()
				y = MARGIN
			}

			// Carte grise d'un élément de la recette : son fond est posé avant son
			// contenu, d'où une hauteur calculée à l'avance (voir columnHeight).
			const fillCard = (top, height) => {
				doc.setFillColor(CARD_FILL[0], CARD_FILL[1], CARD_FILL[2])
				doc.roundedRect(MARGIN, top, contentW, height, CARD_RADIUS, CARD_RADIUS, 'F')
			}

			// --- En-tête : le nom de la recette à gauche, le blog à droite ---
			const title = (data.name || '').trim() || data.kindLabel || 'Ma recette'
			applyFont(11, 'bold', MUTED)
			const brand = 'Terres Sucrées'
			const brandW = doc.getTextWidth(brand)
			doc.text(brand, pageW - MARGIN, y + 7, { align: 'right', baseline: 'top' })
			applyFont(22, 'bold', PRIMARY)
			const titleLines = doc.splitTextToSize(title, contentW - brandW - 24)
			doc.text(titleLines, MARGIN, y, { baseline: 'top' })
			y += titleLines.length * 22 * LINE_FACTOR + 12
			doc.setDrawColor(PRIMARY[0], PRIMARY[1], PRIMARY[2])
			doc.setLineWidth(1.2)
			doc.line(MARGIN, y, pageW - MARGIN, y)
			y += 24

			// --- Montage ---------------------------------------------------
			y += draw('Montage', MARGIN, y, contentW, 16, 'bold', PRIMARY) + 8
			data.components.forEach((component, index) => {
				const text = `${index + 1}.  ${component.name}`
				const h = heightOf(text, contentW - 8, 11)
				if (y + h > bottom) newPage()
				y += draw(text, MARGIN + 4, y, contentW - 8, 11) + 5
			})
			y += 20

			// --- Recette : une carte grise par élément ----------------------
			if (y + 34 > bottom) newPage()
			y += draw('Recette', MARGIN, y, contentW, 16, 'bold', PRIMARY) + 14

			// Deux colonnes côte à côte, à l'intérieur d'une carte.
			const drawColumns = (ingredients, steps, top) => {
				const leftX = MARGIN + CARD_PAD
				const rightX = leftX + colW + GUTTER

				let ly = top
				ly += draw('INGRÉDIENTS', leftX, ly, colW, 9, 'bold', PRIMARY) + 8
				ingredients.forEach((item) => {
					ly += draw(item, leftX + 2, ly, colW - 12, 10) + ITEM_GAP
				})

				let ry = top
				ry += draw('ÉTAPES', rightX, ry, colW, 9, 'bold', PRIMARY) + 8
				steps.forEach((item) => {
					ry += draw(item, rightX + 2, ry, colW - 12, 10) + ITEM_GAP
				})

				return Math.max(ly, ry) - top
			}

			const columnHeight = (ingredients, steps) => {
				const head = heightOf('INGRÉDIENTS', colW, 9, 'bold') + 8
				const list = (items) =>
					items.reduce((total, item) => total + heightOf(item, colW - 12, 10) + ITEM_GAP, 0)
				return Math.max(head + list(ingredients), head + list(steps))
			}

			data.components.forEach((component) => {
				const ingredients = component.ingredients.map(
					(ing) => `-  ${ing.item}${ing.quantity ? ` (${ing.quantity})` : ''}`
				)
				const steps = component.steps.map((step, index) => `${index + 1}.  ${step}`)
				const source = sourceLabel(component.source)

				const headH =
					heightOf(component.name, innerW, 13, 'bold') +
					(source ? 4 + heightOf(source, innerW, 9, 'italic') : 0) +
					(component.description ? 10 + heightOf(component.description, innerW, 10) : 0) +
					(source || component.description ? 10 : 0)
				const cardH = CARD_PAD * 2 + headH + columnHeight(ingredients, steps)

				// La carte tient sur une page : fond gris, puis contenu par-dessus.
				if (cardH <= bottom - MARGIN) {
					if (y + cardH > bottom) newPage()
					const top = y
					const leftX = MARGIN + CARD_PAD
					fillCard(top, cardH)
					let cy = top + CARD_PAD
					cy += draw(component.name, leftX, cy, innerW, 13, 'bold', PRIMARY)
					if (source) {
						cy += 4
						cy += draw(source, leftX, cy, innerW, 9, 'italic', MUTED)
					}
					if (component.description) {
						cy += 10
						cy += draw(component.description, leftX, cy, innerW, 10)
					}
					if (source || component.description) cy += 10
					drawColumns(ingredients, steps, cy)
					y = top + cardH + CARD_GAP
					return
				}

				// Élément plus haut qu'une page (rare) : les sections s'empilent et la
				// carte est découpée page par page.
				const rows = []
				const pushRow = (text, size, style, color, width, indent = 0) => {
					rows.push({
						text,
						size,
						style,
						color,
						width,
						indent,
						height: heightOf(text, width, size, style)
					})
				}
				const pushGap = (gap) => rows.push({ gap })

				pushRow(component.name, 13, 'bold', PRIMARY, innerW)
				if (source) {
					pushGap(4)
					pushRow(source, 9, 'italic', MUTED, innerW)
				}
				if (component.description) {
					pushGap(10)
					pushRow(component.description, 10, 'normal', BODY, innerW)
				}
				pushGap(10)
				pushRow('INGRÉDIENTS', 9, 'bold', PRIMARY, innerW)
				pushGap(8)
				ingredients.forEach((item) => {
					pushRow(item, 10, 'normal', BODY, innerW - 2, 2)
					pushGap(ITEM_GAP)
				})
				pushGap(14)
				pushRow('ÉTAPES', 9, 'bold', PRIMARY, innerW)
				pushGap(8)
				steps.forEach((item) => {
					pushRow(item, 10, 'normal', BODY, innerW - 2, 2)
					pushGap(ITEM_GAP)
				})

				// Découpe en segments d'une page, sans laisser de blanc en fin de carte.
				const limit = bottom - MARGIN - CARD_PAD * 2
				const segments = []
				let segment = []
				let used = 0
				for (const row of rows) {
					const height = row.height ?? row.gap
					if (used + height > limit && segment.some((item) => item.height !== undefined)) {
						while (segment.length && segment[segment.length - 1].height === undefined) {
							used -= segment.pop().gap
						}
						segments.push(segment)
						segment = []
						used = 0
					}
					segment.push(row)
					used += height
				}
				segments.push(segment)

				segments.forEach((segmentRows) => {
					const height =
						CARD_PAD * 2 + segmentRows.reduce((total, row) => total + (row.height ?? row.gap), 0)
					if (y + height > bottom) newPage()
					const top = y
					fillCard(top, height)
					let cy = top + CARD_PAD
					for (const row of segmentRows) {
						if (row.height === undefined) {
							cy += row.gap
							continue
						}
						draw(
							row.text,
							MARGIN + CARD_PAD + row.indent,
							cy,
							row.width,
							row.size,
							row.style,
							row.color
						)
						cy += row.height
					}
					y = top + height + CARD_GAP
				})
			})

			// --- Pied de page ----------------------------------------------
			const total = doc.getNumberOfPages()
			for (let page = 1; page <= total; page++) {
				doc.setPage(page)
				applyFont(8, 'normal', MUTED)
				doc.text(`Terres Sucrées - page ${page}/${total}`, pageW / 2, pageH - 26, {
					align: 'center',
					baseline: 'top'
				})
			}

			// Le fichier téléchargé porte le nom choisi, sinon le type de recette.
			const suffix = (data.name || '').trim() ? slugify(data.name) : ''
			doc.save(`recette-${suffix || data.kind}.pdf`)
		}

		document.addEventListener('click', async (event) => {
			const target = event.target
			if (!(target instanceof Element) || !target.closest('#builder-download')) return
			const data = window.__recipePdfData
			if (!data || !data.components?.length) return
			// Le nom est lu au moment du clic : il peut avoir été saisi après le
			// dernier rendu du bloc.
			const nameField = document.getElementById('builder-name')
			const name = nameField ? nameField.value.trim() : ''
			try {
				const { jsPDF } = await import('jspdf')
				buildRecipePdf(jsPDF, { ...data, name })
			} catch (error) {
				console.error('Export PDF impossible', error)
			}
		})
	</script>
</BaseLayout>
