---
// src/pages/order.astro
import BaseLayout from '@/layouts/BaseLayout'
import DatePicker from '@/components/DatePicker'
import PopSelect from '@/components/PopSelect'

// Le site est statique (Render) : aucun serveur ne peut envoyer d'e-mail.
// FormSubmit relaie donc le formulaire vers la boîte de réception de la
// marque, sans clé ni compte. La première soumission déclenche un e-mail de
// confirmation ; une fois confirmé, FormSubmit propose une chaîne aléatoire à
// mettre à la place de l'adresse dans les deux URL ci-dessous (elle est alors
// moins exposée aux robots à spam). Le formulaire fonctionne aussi sans
// JavaScript : il poste alors vers le point d'entrée classique.
const ORDER_EMAIL = 'terres.sucrees@gmail.com'
const FORM_ACTION = `https://formsubmit.co/${ORDER_EMAIL}`
const FORM_ENDPOINT = `https://formsubmit.co/ajax/${ORDER_EMAIL}`

// La date de retrait souhaitée demande une semaine de délai : aucune date avant
// aujourd'hui + 7 jours n'est proposée, les suivantes restent libres. Les dates
// sont calculées en heure locale : `toISOString()` bascule en UTC et renverrait
// encore la veille entre minuit et deux heures du matin.
const toIsoDate = (date: Date) =>
	`${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, '0')}-${String(
		date.getDate()
	).padStart(2, '0')}`

const now = new Date()
const firstDate = toIsoDate(new Date(now.getFullYear(), now.getMonth(), now.getDate() + 7))
---

<BaseLayout title='Commande'>
	<div class='flex flex-col items-center gap-4 text-center'>
		<span class='pop-chip pop-chip--butter'>Tablettes Breizh chocolat</span>
		<h1 class='pop-display text-4xl sm:text-5xl md:text-6xl'>Commande</h1>
		<p class='max-w-xl text-base leading-relaxed text-ink/70 dark:text-ink-body'>
			Commandez votre Breizh Chocolat : tablette de chocolat noir fourrée au caramel beurre salé,
			praliné sarrasin et crêpes dentelles !
		</p>
	</div>

	<form
		id='order-form'
		class='pop-card mx-auto mt-2 w-full max-w-2xl p-6 sm:p-8'
		method='POST'
		action={FORM_ACTION}
		data-endpoint={FORM_ENDPOINT}
		data-email={ORDER_EMAIL}
	>
		<!-- Réglages FormSubmit : objet de l'e-mail, mise en page en tableau,
		     captcha désactivé (incompatible avec l'envoi en AJAX) et champ
		     piège anti-robots. -->
		<input type='hidden' name='_subject' value='Nouvelle commande — tablettes Breizh chocolat' />
		<input type='hidden' name='_template' value='table' />
		<input type='hidden' name='_captcha' value='false' />
		<input
			type='text'
			name='_honey'
			tabindex='-1'
			autocomplete='off'
			aria-hidden='true'
			class='hidden'
		/>

		<div class='grid gap-5 sm:grid-cols-2'>
			<label class='flex flex-col gap-2'>
				<span class='text-sm font-bold'>Nom</span>
				<input
					type='text'
					name='Nom'
					class='pop-field'
					autocomplete='name'
					placeholder='Camille Dupont'
					required
				/>
			</label>

			<label class='flex flex-col gap-2'>
				<span class='text-sm font-bold'>Téléphone</span>
				<input
					type='tel'
					name='Téléphone'
					class='pop-field'
					autocomplete='tel'
					inputmode='tel'
					placeholder='06 12 34 56 78'
					required
				/>
			</label>

			<DatePicker
				name='Date de retrait souhaitée'
				label='Date de retrait souhaitée'
				min={firstDate}
			/>

			<PopSelect
				name='Méthode de retrait'
				label='Méthode de retrait'
				placeholder='Choisir une méthode…'
				errorMessage='Choisissez une méthode de retrait.'
				options={[
					{ value: 'En main propre sur Paris', label: 'En main propre sur Paris' },
					// Le port est annoncé dans l'option ; la valeur envoyée reste
					// « Envoi postal », c'est elle que lit le calcul du total.
					{ value: 'Envoi postal', label: 'Envoi postal (+4 €)' }
				]}
			/>

			<label class='flex flex-col gap-2 sm:col-span-2'>
				<span class='text-sm font-bold'>Quantité de tablettes</span>
				<input
					type='number'
					name='Quantité de tablettes'
					class='pop-field'
					min='1'
					step='1'
					value='1'
					inputmode='numeric'
					required
				/>
			</label>
		</div>

		<label class='mt-5 flex flex-col gap-2'>
			<span class='text-sm font-bold'>Informations complémentaires</span>
			<textarea
				name='Informations complémentaires'
				class='pop-field resize-y'
				rows='4'
				placeholder='Détails sur le retrait souhaité, précisions sur votre commande…'></textarea>
		</label>

		<!-- Le total est calculé par le script : masqué tant qu'il n'a pas pu
		     l'être, pour ne jamais afficher un prix périmé. -->
		<div
			data-price-panel
			hidden
			class='pop-panel mt-5 flex items-center justify-between gap-3 px-4 py-3'
		>
			<!-- `min-w-0` laisse la légende se replier : le montant reste sur sa
			     ligne, calé à droite et centré verticalement. -->
			<div class='flex min-w-0 flex-1 flex-col gap-0.5'>
				<span
					class='text-[11px] font-bold uppercase tracking-[0.16em] text-ink/60 dark:text-ink-faint'
				>
					Total estimé
				</span>
				<p id='order-price-detail' class='text-xs leading-snug text-ink/60 dark:text-ink-faint'></p>
			</div>
			<!-- Motter Corpus réserve la place d'un descendent que « 13,00 € »
			     n'utilise pas : les chiffres optent 3 px trop haut. Ce décalage,
			     exprimé en `em`, les recentre sur la ligne du bloc de gauche. -->
			<p
				id='order-total'
				class='pop-display shrink-0 translate-y-[0.1em] whitespace-nowrap text-right text-3xl'
				aria-live='polite'
			>
			</p>
		</div>

		<p class='mt-4 text-xs leading-relaxed text-ink/60 dark:text-ink-faint'>
			Tous les champs sont obligatoires, sauf les informations complémentaires. Vos informations
			servent uniquement à traiter votre commande. Un souci pour envoyer le formulaire ?
			Écrivez-nous à
			<a
				href={`mailto:${ORDER_EMAIL}`}
				class='font-bold underline decoration-2 underline-offset-2 hover:text-grape dark:hover:text-primary_second'
				>{ORDER_EMAIL}</a
			>.
		</p>

		<div class='mt-6 flex flex-wrap items-center gap-4'>
			<button type='submit' class='pop-btn'>
				Envoyer ma commande
				<svg
					class='h-4 w-4'
					fill='none'
					stroke='currentColor'
					viewBox='0 0 24 24'
					aria-hidden='true'
				>
					<path
						stroke-linecap='round'
						stroke-linejoin='round'
						stroke-width='2'
						d='M5 12h14m0 0l-6-6m6 6l-6 6'></path>
				</svg>
			</button>
			<p
				id='order-status'
				role='status'
				aria-live='polite'
				class='text-sm leading-snug text-ink/70 dark:text-ink-body'
			>
			</p>
		</div>
	</form>

	<!-- Confirmé : le formulaire disparaît pour qu'une commande ne puisse pas être
	     envoyée deux fois. -->
	<div
		id='order-success'
		hidden
		class='pop-card mx-auto mt-2 w-full max-w-2xl p-6 text-center sm:p-8'
	>
		<span class='pop-chip pop-chip--mint'>Commande envoyée</span>
		<p class='mt-3 text-sm leading-relaxed text-ink/70 dark:text-ink-body'>
			Merci ! Votre commande de tablettes Breizh chocolat nous est bien parvenue. Elle ne sera
			définitive qu'une fois confirmée : un message vous parviendra pour la valider et convenir du
			retrait.
		</p>
	</div>
</BaseLayout>

<script>
	const form = document.getElementById('order-form') as HTMLFormElement | null
	const status = document.getElementById('order-status')
	const success = document.getElementById('order-success')

	// Prix ---------------------------------------------------------------

	// Grille tarifaire : 13 € la tablette seule, 12,50 € dès la deuxième, 12 €
	// dès la troisième, 11 € dès la cinquième et 10 € dès la dixième. Ces paliers
	// reproduisent au centime près les totaux annoncés (25 €, 36 €, 55 €, 100 €).
	const unitPrice = (count: number) => {
		if (count >= 10) return 10
		if (count >= 5) return 11
		if (count >= 3) return 12
		if (count === 2) return 12.5
		return 13
	}
	const POSTAL_FEE = 4
	const euros = new Intl.NumberFormat('fr-FR', { style: 'currency', currency: 'EUR' })

	const quantity = form?.querySelector<HTMLInputElement>('input[name="Quantité de tablettes"]')
	const method = form?.querySelector<HTMLSelectElement>('select[name="Méthode de retrait"]')
	const pricePanel = document.querySelector<HTMLElement>('[data-price-panel]')
	const totalOutput = document.getElementById('order-total')
	const detailOutput = document.getElementById('order-price-detail')

	const updatePrice = () => {
		if (!quantity || !totalOutput || !pricePanel) return

		const count = Math.max(1, Math.floor(Number(quantity.value) || 1))
		const unit = unitPrice(count)
		const postal = method?.value === 'Envoi postal'

		totalOutput.textContent = euros.format(count * unit + (postal ? POSTAL_FEE : 0))
		if (detailOutput) {
			const rows = [`${count} tablette${count > 1 ? 's' : ''} × ${euros.format(unit)}`]
			if (postal) rows.push(`envoi postal +${euros.format(POSTAL_FEE)}`)
			detailOutput.textContent = rows.join(' · ')
		}
		pricePanel.hidden = false
	}

	quantity?.addEventListener('input', updatePrice)
	quantity?.addEventListener('change', updatePrice)
	// Le menu de retrait notifie son `<select>` natif : le port y est déjà ajouté.
	method?.addEventListener('change', updatePrice)
	updatePrice()

	if (form && status && success) {
		const submitButton = form.querySelector<HTMLButtonElement>('button[type="submit"]')
		const endpoint = form.dataset.endpoint
		const email = form.dataset.email ?? ''
		const setStatus = (message: string) => {
			status.textContent = message
		}

		// Verrou d'envoi : un double clic (ou une touche Entrée martelée) ne doit
		// jamais produire deux e-mails pour une seule commande.
		let sending = false

		form.addEventListener('submit', async (event) => {
			// Sans `endpoint`, on laisse le navigateur poster vers FormSubmit : le
			// visiteur voit alors la page de remerciement du service.
			if (!endpoint) return

			event.preventDefault()
			if (sending) return
			sending = true

			const data = Object.fromEntries(new FormData(form).entries()) as Record<string, string>
			setStatus('Envoi en cours…')
			if (submitButton) submitButton.disabled = true

			try {
				const response = await fetch(endpoint, {
					method: 'POST',
					headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
					body: JSON.stringify({
						...data,
						_subject: `Nouvelle commande — tablettes Breizh chocolat (${data.Nom ?? 'sans nom'})`
					})
				})
				const payload = await response.json().catch(() => null)
				const sent = response.ok && (payload?.success === true || payload?.success === 'true')
				// Le motif renvoyé par le service (« This form needs Activation »,
				// adresse invalide…) reste dans la console : le visiteur, lui, n'a que
				// le message français et le repli par e-mail.
				if (!sent) {
					throw new Error(
						`FormSubmit a refusé l'envoi (${response.status}) : ${payload?.message ?? 'réponse illisible'}`
					)
				}

				form.reset()
				setStatus('')
				form.hidden = true
				success.hidden = false
				submitButton?.blur()
			} catch (error) {
				console.error('Envoi de la commande impossible', error)
				setStatus(`L'envoi a échoué. Réessayez dans un instant ou écrivez-nous à ${email}.`)
			} finally {
				sending = false
				if (submitButton) submitButton.disabled = false
			}
		})
	}
</script>
