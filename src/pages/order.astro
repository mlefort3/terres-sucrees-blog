---
// src/pages/order.astro
import BaseLayout from '@/layouts/BaseLayout'

// Le site est statique (Render) : aucun serveur ne peut envoyer d'e-mail.
// FormSubmit relaie donc le formulaire vers la boîte de réception de la
// marque, sans clé ni compte. La première soumission déclenche un e-mail de
// confirmation ; une fois confirmé, FormSubmit propose une chaîne aléatoire à
// mettre à la place de l'adresse dans les deux URL ci-dessous (elle est alors
// moins exposée aux robots à spam). Le formulaire fonctionne aussi sans
// JavaScript : il poste alors vers le point d'entrée classique.
const ORDER_EMAIL = 'terres.sucrees@gmail.com'
const FORM_ACTION = `https://formsubmit.co/${ORDER_EMAIL}`
const FORM_ENDPOINT = `https://formsubmit.co/ajax/${ORDER_EMAIL}`

// La date de retrait ne peut pas être passée.
const today = new Date().toISOString().slice(0, 10)
---

<BaseLayout title='Commande'>
	<div class='flex flex-col items-center gap-4 text-center'>
		<span class='pop-chip pop-chip--butter'>Tablettes Breizh chocolat</span>
		<h1 class='pop-display text-4xl sm:text-5xl md:text-6xl'>Commande</h1>
		<p class='max-w-xl text-base leading-relaxed text-ink/70 dark:text-ink-body'>
			Commandez votre Breizh Chocolat : tablette de chocolat noir fourrée au caramel beurre salé,
			praliné sarrasin et crêpes dentelles !
		</p>
	</div>

	<form
		id='order-form'
		class='pop-card mx-auto mt-2 w-full max-w-2xl p-6 sm:p-8'
		method='POST'
		action={FORM_ACTION}
		data-endpoint={FORM_ENDPOINT}
		data-email={ORDER_EMAIL}
	>
		<!-- Réglages FormSubmit : objet de l'e-mail, mise en page en tableau,
		     captcha désactivé (incompatible avec l'envoi en AJAX) et champ
		     piège anti-robots. -->
		<input type='hidden' name='_subject' value='Nouvelle commande — tablettes Breizh chocolat' />
		<input type='hidden' name='_template' value='table' />
		<input type='hidden' name='_captcha' value='false' />
		<input
			type='text'
			name='_honey'
			tabindex='-1'
			autocomplete='off'
			aria-hidden='true'
			class='hidden'
		/>

		<div class='grid gap-5 sm:grid-cols-2'>
			<label class='flex flex-col gap-2'>
				<span class='text-sm font-bold'>Nom</span>
				<input
					type='text'
					name='Nom'
					class='pop-field'
					autocomplete='name'
					placeholder='Camille Dupont'
					required
				/>
			</label>

			<label class='flex flex-col gap-2'>
				<span class='text-sm font-bold'>Téléphone</span>
				<input
					type='tel'
					name='Téléphone'
					class='pop-field'
					autocomplete='tel'
					inputmode='tel'
					placeholder='06 12 34 56 78'
					required
				/>
			</label>

			<label class='flex flex-col gap-2'>
				<span class='text-sm font-bold'>Date de retrait</span>
				<input type='date' name='Date de retrait' class='pop-field' min={today} required />
			</label>

			<label class='flex flex-col gap-2'>
				<span class='text-sm font-bold'>Quantité de tablettes</span>
				<input
					type='number'
					name='Quantité de tablettes'
					class='pop-field'
					min='1'
					step='1'
					value='1'
					inputmode='numeric'
					required
				/>
			</label>
		</div>

		<label class='mt-5 flex flex-col gap-2'>
			<span class='text-sm font-bold'>Informations complémentaires</span>
			<textarea
				name='Informations complémentaires'
				class='pop-field resize-y'
				rows='4'
				placeholder='Heure de retrait souhaitée, précisions sur votre commande…'></textarea>
		</label>

		<p class='mt-4 text-xs leading-relaxed text-ink/60 dark:text-ink-faint'>
			Tous les champs sont obligatoires, sauf les informations complémentaires. Vos informations
			servent uniquement à traiter votre commande. Un souci pour envoyer le formulaire ?
			Écrivez-nous à
			<a
				href={`mailto:${ORDER_EMAIL}`}
				class='font-bold underline decoration-2 underline-offset-2 hover:text-grape dark:hover:text-primary_second'
				>{ORDER_EMAIL}</a
			>.
		</p>

		<div class='mt-6 flex flex-wrap items-center gap-4'>
			<button type='submit' class='pop-btn'>
				Envoyer ma commande
				<svg
					class='h-4 w-4'
					fill='none'
					stroke='currentColor'
					viewBox='0 0 24 24'
					aria-hidden='true'
				>
					<path
						stroke-linecap='round'
						stroke-linejoin='round'
						stroke-width='2'
						d='M5 12h14m0 0l-6-6m6 6l-6 6'></path>
				</svg>
			</button>
			<p
				id='order-status'
				role='status'
				aria-live='polite'
				class='text-sm leading-snug text-ink/70 dark:text-ink-body'
			>
			</p>
		</div>
	</form>

	<!-- Confirmé : le formulaire disparaît pour qu'une commande ne puisse pas être
	     envoyée deux fois. -->
	<div
		id='order-success'
		hidden
		class='pop-card mx-auto mt-2 w-full max-w-2xl p-6 text-center sm:p-8'
	>
		<span class='pop-chip pop-chip--mint'>Commande envoyée</span>
		<p class='mt-3 text-sm leading-relaxed text-ink/70 dark:text-ink-body'>
			Merci ! Votre commande de tablettes Breizh chocolat nous est bien parvenue. Nous vous
			rappelons au numéro indiqué pour la confirmer et convenir du retrait.
		</p>
	</div>
</BaseLayout>

<script>
	const form = document.getElementById('order-form') as HTMLFormElement | null
	const status = document.getElementById('order-status')
	const success = document.getElementById('order-success')

	if (form && status && success) {
		const submitButton = form.querySelector<HTMLButtonElement>('button[type="submit"]')
		const endpoint = form.dataset.endpoint
		const email = form.dataset.email ?? ''
		const setStatus = (message: string) => {
			status.textContent = message
		}

		// Verrou d'envoi : un double clic (ou une touche Entrée martelée) ne doit
		// jamais produire deux e-mails pour une seule commande.
		let sending = false

		form.addEventListener('submit', async (event) => {
			// Sans `endpoint`, on laisse le navigateur poster vers FormSubmit : le
			// visiteur voit alors la page de remerciement du service.
			if (!endpoint) return

			event.preventDefault()
			if (sending) return
			sending = true

			const data = Object.fromEntries(new FormData(form).entries()) as Record<string, string>
			setStatus('Envoi en cours…')
			if (submitButton) submitButton.disabled = true

			try {
				const response = await fetch(endpoint, {
					method: 'POST',
					headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
					body: JSON.stringify({
						...data,
						_subject: `Nouvelle commande — tablettes Breizh chocolat (${data.Nom ?? 'sans nom'})`
					})
				})
				const payload = await response.json().catch(() => null)
				const sent = response.ok && (payload?.success === true || payload?.success === 'true')
				// Le motif renvoyé par le service (« This form needs Activation »,
				// adresse invalide…) reste dans la console : le visiteur, lui, n'a que
				// le message français et le repli par e-mail.
				if (!sent) {
					throw new Error(
						`FormSubmit a refusé l'envoi (${response.status}) : ${payload?.message ?? 'réponse illisible'}`
					)
				}

				form.reset()
				setStatus('')
				form.hidden = true
				success.hidden = false
				submitButton?.blur()
			} catch (error) {
				console.error('Envoi de la commande impossible', error)
				setStatus(`L'envoi a échoué. Réessayez dans un instant ou écrivez-nous à ${email}.`)
			} finally {
				sending = false
				if (submitButton) submitButton.disabled = false
			}
		})
	}
</script>
