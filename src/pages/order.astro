---
// src/pages/order.astro
import BaseLayout from '@/layouts/BaseLayout'
---

<BaseLayout title='Commande'>
	<div class='flex flex-col items-center gap-4 text-center'>
		<span class='pop-chip pop-chip--butter'>Sur commande</span>
		<h1 class='pop-display text-4xl sm:text-5xl md:text-6xl'>Commande</h1>
		<p class='max-w-xl text-base leading-relaxed text-ink/70 dark:text-ink-body'>
			Remplissez le formulaire ci-dessous pour passer commande.
		</p>
	</div>
	<div class='pop-card overflow-hidden p-2'>
		<iframe
			src='https://framaforms.org/commande-breizh-chocolat-1761822690'
			width='100%'
			height='1000'
			border='0'
			class='rounded-[1.1rem]'></iframe>
	</div>
</BaseLayout>
