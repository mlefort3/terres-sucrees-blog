---
import BaseLayout from '@/layouts/BaseLayout'
import ListPosts from '@/components/ListPosts'
import TitlePage from '@/components/TitlePage'
import { unsluglify, getTags, getPostByTag } from '@/utils'

export async function getStaticPaths() {
	// `getTags` renvoie des identifiants d'URL (voir `tagSlug`), donc deux
	// graphies d'un même tag ne génèrent qu'une seule page.
	const tags = await getTags()

	return tags.map((tag) => ({
		params: { tag },
		props: { tag }
	}))
}

const { tag } = Astro.props

const unsluglifyNameTag = unsluglify(tag)

const posts = await getPostByTag(tag)
---

<BaseLayout title={`${unsluglifyNameTag} — recettes véganes`} noindex={false} gradient>
	<TitlePage title={unsluglifyNameTag} />
	<ListPosts posts={posts} />
</BaseLayout>
