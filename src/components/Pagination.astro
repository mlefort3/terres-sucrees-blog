---
import ArrowLeft from './icons/ArrowLeft.astro'
import ArrowRight from './icons/ArrowRight.astro'

const { page } = Astro.props

// `paginate` renvoie des URL sans « / » final alors que la balise canonical
// pointe vers la forme avec « / » : on aligne les liens internes dessus.
const canonical = (url: string) => (url.endsWith('/') ? url : `${url}/`)
---

<nav class='flex justify-between gap-3 md:justify-end' aria-label='Pagination'>
	{
		page.start > 0 && (
			<a href={canonical(page.url.prev)} class='pop-btn pop-btn--paper pop-btn--sm'>
				<ArrowLeft />
				<span class='hidden sm:inline'>Précédentes</span>
			</a>
		)
	}

	{
		page.currentPage < page.lastPage && (
			<a href={canonical(page.url.next)} class='pop-btn pop-btn--sm ml-auto'>
				<span class='hidden sm:inline'>Suivantes</span>
				<ArrowRight />
			</a>
		)
	}
</nav>
