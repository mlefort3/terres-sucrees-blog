---
// Composant pour afficher les ingrédients de recettes modulaires
interface Props {
	title: string
	description?: string | null
	recipeIngredientIds: string[]
}

import { getCollection } from 'astro:content'
import RecipePdfButton from '@/components/RecipePdfButton'

const { title, description = null, recipeIngredientIds = [] } = Astro.props

// Charger tous les ingrédients de recettes disponibles
const allRecipeIngredients = await getCollection('recipeIngredients')

// Filtrer les ingrédients demandés
const recipeIngredients = recipeIngredientIds
	.map((id) => allRecipeIngredients.find((ing) => ing.id === id))
	.filter((ing) => ing !== undefined)

// Données transmises au bouton d'export PDF (titre + chapeau de l'article).
const pdfComponents = recipeIngredients.map((ingredient) => ({
	name: ingredient.data.name,
	description: ingredient.data.description ?? null,
	source: ingredient.data.source ?? null,
	ingredients: ingredient.data.ingredients.map((ing) => ({
		item: ing.item,
		quantity: ing.quantity ?? null
	})),
	steps: ingredient.data.steps
}))
---

{
	recipeIngredients && recipeIngredients.length > 0 && (
		<div class='w-full'>
			<div class='flex flex-wrap items-center justify-between gap-4 mb-8'>
				<h2 id='recette' class='pop-display text-4xl'>
					Recette
				</h2>
				<RecipePdfButton title={title} description={description} components={pdfComponents} />
			</div>
			<div class='space-y-8'>
				{recipeIngredients.map((ingredient) => (
					<div class='pop-panel p-5 pb-6 md:p-6 last:pb-6'>
						<h3
							id={`ingredient-${ingredient.id}`}
							class='pop-display mb-2 text-2xl text-ink dark:text-ink-text'
						>
							{ingredient.data.name}
						</h3>

						{ingredient.data.source && (
							<p class='text-sm text-slate-600 dark:text-ink-muted italic mb-3'>
								Basé sur la recette de{' '}
								{typeof ingredient.data.source === 'string' ? (
									ingredient.data.source
								) : (
									<a
										href={ingredient.data.source.url}
										target='_blank'
										rel='noopener noreferrer'
										class='text-primary hover:underline font-medium'
									>
										{ingredient.data.source.title}
									</a>
								)}
							</p>
						)}

						{ingredient.data.description && (
							<p class='text-slate-700 dark:text-ink-body text-base mb-4'>
								{ingredient.data.description}
							</p>
						)}

						<div class='grid grid-cols-1 md:grid-cols-2 gap-8'>
							<div>
								{' '}
								<h4 class='mb-4 text-[11px] font-bold uppercase tracking-[0.16em] text-primary dark:text-primary_second'>
									Ingrédients
								</h4>
								<ul class='space-y-3'>
									{ingredient.data.ingredients && ingredient.data.ingredients.length > 0 ? (
										ingredient.data.ingredients.map((ing) => (
											<li class='text-[15px] leading-relaxed text-ink/80 dark:text-ink-body'>
												<span class='font-bold text-primary dark:text-primary_second'>– </span>
												{ing.item}
												{ing.quantity && (
													<span class='text-slate-500 dark:text-ink-faint text-sm'>
														{' '}
														({ing.quantity})
													</span>
												)}
											</li>
										))
									) : (
										<li class='text-slate-500'>Aucun ingrédient</li>
									)}
								</ul>
							</div>

							<div>
								<h4 class='mb-4 text-[11px] font-bold uppercase tracking-[0.16em] text-primary dark:text-primary_second'>
									Étapes
								</h4>
								<ol class='space-y-3'>
									{ingredient.data.steps && ingredient.data.steps.length > 0 ? (
										ingredient.data.steps.map((step, idx) => (
											<li class='text-[15px] leading-relaxed text-ink/80 dark:text-ink-body'>
												<span class='font-bold text-primary dark:text-primary_second'>
													{idx + 1}.{' '}
												</span>
												{step}
											</li>
										))
									) : (
										<li class='text-slate-500'>Aucune étape</li>
									)}
								</ol>
							</div>
						</div>
					</div>
				))}
			</div>
		</div>
	)
}
