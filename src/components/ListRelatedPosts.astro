---
import type { CollectionEntry } from 'astro:content'
import { cn } from '@/utils'
import { Image } from 'astro:assets'

type Props = {
	posts: CollectionEntry<'blog'>[]
}

const { posts } = Astro.props
---

<section class={cn('grid gap-4 sm:grid-cols-2 lg:grid-cols-3')}>
	{
		posts.length > 0 ? (
			posts.map((post) => {
				return (
					<a
						href={`/post/${post.slug}/`}
						class='group flex items-center gap-4 rounded-xl border-2 border-outline bg-white p-3 shadow-[3px_3px_0_0_#241e38] transition hover:-translate-y-0.5 hover:bg-butter dark:border-ink-line dark:bg-ink-surface dark:shadow-[3px_3px_0_0_rgba(189,183,253,0.18)] dark:hover:bg-ink-raised'
					>
						<Image
							src={post.data.heroImage}
							width={160}
							height={160}
							format='webp'
							alt={`Photo de la recette : ${post.data.title}`}
							class='h-14 w-14 shrink-0 rounded-lg border-2 border-outline object-cover dark:border-ink-line'
						/>

						<h3 class='line-clamp-2 font-display text-lg leading-tight text-ink dark:text-ink-text'>
							{post.data.title}
						</h3>
					</a>
				)
			})
		) : (
			<span class='text-ink/60 dark:text-ink-muted'>There are no related posts yet. 😢</span>
		)
	}
</section>
