---
import HeaderLink from '@/components/HeaderLink'
import MenuIcon from './icons/MenuIcon.astro'
import Search from '@/components/Search'
import ToggleTheme from './ToggleTheme.astro'
import { SOCIALNETWORKS } from '@/data/links'

// Deux menus identiques (Créations / Compositions) : les données sont décrites
// une fois, la barre de bureau et le tiroir mobile s'en servent tous les deux.
const menus = [
	{
		label: 'Créations',
		id: 'creations',
		links: [
			{ href: '/tags/entremets/', label: 'Entremets' },
			{ href: '/tags/tartes/', label: 'Tartes' },
			{ href: '/tags/gâteaux-de-voyage/', label: 'Gâteaux de voyage' },
			{ href: '/tags/chocolat/', label: 'Chocolat' }
		]
	},
	{
		label: 'Compositions',
		id: 'compositions',
		links: [
			{ href: '/ingredients/', label: 'Préparations' },
			{ href: '/creer-ma-recette/', label: 'Créer ma recette' }
		]
	}
]

const navLinkClass =
	'font-semibold text-base lg:text-[17px] text-ink dark:text-ink-text transition-colors hover:text-primary dark:hover:text-primary_second'
// Le menu s'ouvre au survol mais aussi au clavier (`focus-within`) : sans cela,
// les entrées des sous-menus seraient inatteignables sans souris.
const dropdownClass =
	'absolute invisible opacity-0 translate-y-1 transition-all duration-150 top-full left-0 pt-3 z-50 group-hover:visible group-hover:opacity-100 group-hover:translate-y-0 group-focus-within:visible group-focus-within:opacity-100 group-focus-within:translate-y-0'
const dropdownPanelClass =
	'min-w-[200px] rounded-xl border-2 border-outline bg-white py-2 shadow-[4px_4px_0_0_#241e38] dark:border-ink-line dark:bg-ink-surface dark:shadow-[4px_4px_0_0_rgba(189,183,253,0.18)]'
---

<header
	class='fixed top-0 left-0 right-0 z-50 border-b-2 border-outline bg-white dark:border-ink-line dark:bg-ink'
>
	<div
		class='max-w-7xl mx-auto flex items-center justify-between gap-2 h-[76px] px-3 sm:px-4 md:px-8'
	>
		<!-- LEFT: Logo + Title -->
		<div class='flex min-w-0 items-center gap-3'>
			{
				/* Logo rond (croissant + arc violet) restauré depuis l'historique Git :
			   il était référencé mais le fichier avait été supprimé de /public. */
			}
			<a
				href='/'
				class='group flex min-w-0 items-center gap-2.5 sm:gap-3'
				aria-label='Terres Sucrées — accueil'
			>
				<img
					src='/images/logo.png'
					alt=''
					width='44'
					height='44'
					class='h-9 w-9 shrink-0 object-contain sm:h-11 sm:w-11'
				/>
				<span class='flex min-w-0 flex-col leading-none'>
					<span class='font-display text-[20px] sm:text-3xl text-ink dark:text-ink-text'>
						Terres{' '}
						{
							/* Même surlignage au marqueur que le mot « recettes » de l'accueil,
						   mais tracé en bleu. `leading-none` resserre la boîte pour que le
						   trait vienne toucher le bas des lettres, comme sur le grand titre. */
						}
						<span class='pop-marker pop-marker--blue leading-none'>Sucrées</span>
					</span>
					<span
						class='hidden lg:inline pl-0.5 pt-1.5 text-[10px] font-bold uppercase tracking-[0.22em] text-ink/60 dark:text-ink-muted'
					>
						Pâtisserie végétale
					</span>
				</span>
			</a>
		</div>

		<!-- CENTER: Main Navigation -->
		<nav class='hidden md:flex items-center gap-4 lg:gap-7 whitespace-nowrap'>
			{
				menus.map((menu) => (
					<div class='relative group'>
						<button
							class={`flex items-center gap-1.5 cursor-pointer focus:outline-none focus-visible:underline ${navLinkClass}`}
						>
							{menu.label}
							<svg
								class='w-3.5 h-3.5 transition-transform group-hover:rotate-180'
								fill='none'
								stroke='currentColor'
								viewBox='0 0 24 24'
								aria-hidden='true'
							>
								<path
									stroke-linecap='round'
									stroke-linejoin='round'
									stroke-width='2.5'
									d='M19 9l-7 7-7-7'
								/>
							</svg>
						</button>
						<div class={dropdownClass}>
							<ul class={dropdownPanelClass}>
								{menu.links.map((link) => (
									<li>
										<a
											href={link.href}
											class='block px-4 py-2 text-[15px] font-medium hover:bg-butter hover:text-ink dark:hover:bg-ink-raised dark:hover:text-ink-text'
										>
											{link.label}
										</a>
									</li>
								))}
							</ul>
						</div>
					</div>
				))
			}
			<a href='/about/' class={navLinkClass}>À propos</a>
		</nav>

		<!-- RIGHT: Search / Social / Theme / Mobile Menu -->
		<div class='flex shrink-0 items-center gap-1.5 sm:gap-3'>
			<Search />
			<ToggleTheme />
			<div class='hidden md:flex gap-2 pl-1'>
				{
					SOCIALNETWORKS.map((network) => (
						<HeaderLink
							href={network.url}
							target='_blank'
							aria-label={network.name}
							class='flex h-8 w-8 items-center justify-center rounded-lg border-2 border-outline bg-white text-ink transition hover:-translate-y-0.5 hover:bg-lilac hover:shadow-[2px_2px_0_0_#241e38] dark:border-ink-line dark:bg-ink-surface dark:text-ink-text dark:hover:bg-ink-raised'
						>
							<network.icon />
						</HeaderLink>
					))
				}
			</div>
			<button
				id='astro-header-drawer-button'
				type='button'
				class='md:hidden flex h-8 w-8 items-center justify-center rounded-lg border-2 border-outline bg-white text-ink dark:border-ink-line dark:bg-ink-surface dark:text-ink-text sm:h-9 sm:w-9'
			>
				<MenuIcon />
				<span class='sr-only'>Menu</span>
			</button>
		</div>
	</div>
</header>

<!-- Voile sous le tiroir : il referme le menu et détache le panneau du contenu. -->
<div
	id='astro-header-scrim'
	class='fixed inset-0 top-[76px] z-40 hidden bg-outline/45 backdrop-blur-[1px] md:hidden'
	aria-hidden='true'
>
</div>

<!-- MOBILE DRAWER -->
<div
	id='astro-header-drawer'
	class='fixed right-0 top-[76px] z-50 h-[calc(100dvh-76px)] w-64 transform translate-x-full border-l-2 border-outline bg-white p-6 transition-transform duration-300 dark:border-ink-line dark:bg-ink-surface md:hidden'
>
	<nav class='flex flex-col gap-5'>
		{
			menus.map((menu) => (
				<div class='flex flex-col gap-3' data-drawer-group>
					<button
						id={`astro-header-drawer-${menu.id}`}
						type='button'
						class='flex items-center justify-between w-full text-left font-semibold'
						aria-expanded='false'
						aria-controls={`astro-header-drawer-${menu.id}-list`}
						data-drawer-toggle
					>
						{menu.label}
						<svg
							class='w-4 h-4 transition-transform'
							fill='none'
							stroke='currentColor'
							viewBox='0 0 24 24'
							aria-hidden='true'
						>
							<path
								stroke-linecap='round'
								stroke-linejoin='round'
								stroke-width='2.5'
								d='M19 9l-7 7-7-7'
							/>
						</svg>
					</button>
					<div
						id={`astro-header-drawer-${menu.id}-list`}
						class='hidden flex-col gap-3 pl-4'
						data-drawer-list
					>
						{menu.links.map((link) => (
							<HeaderLink href={link.href} class='font-medium'>
								{link.label}
							</HeaderLink>
						))}
					</div>
				</div>
			))
		}
		<HeaderLink href='/about/' class='font-semibold'>À propos</HeaderLink>
		<div class='flex gap-3 mt-4'>
			{
				SOCIALNETWORKS.map((network) => (
					<HeaderLink href={network.url} target='_blank' aria-label={network.name}>
						<network.icon />
					</HeaderLink>
				))
			}
		</div>
	</nav>
</div>

<script>
	// Drawer toggle
	const menu = document.getElementById('astro-header-drawer')
	const menuButton = document.getElementById('astro-header-drawer-button')
	const scrim = document.getElementById('astro-header-scrim')

	const closeDrawer = () => {
		menu.classList.add('translate-x-full')
		scrim.classList.add('hidden')
	}

	menuButton.addEventListener('click', (e) => {
		e.stopPropagation()
		if (menu.classList.contains('translate-x-full')) {
			menu.classList.remove('translate-x-full')
			scrim.classList.remove('hidden')
		} else {
			closeDrawer()
		}
	})

	scrim.addEventListener('click', closeDrawer)

	document.addEventListener('click', (e) => {
		if (!menu.contains(e.target) && !menuButton.contains(e.target)) closeDrawer()
	})

	// Sous-menus du tiroir : « Créations » et « Compositions »
	document.querySelectorAll('[data-drawer-group]').forEach((group) => {
		const button = group.querySelector('[data-drawer-toggle]')
		const list = group.querySelector('[data-drawer-list]')

		button.addEventListener('click', (e) => {
			e.stopPropagation()
			const isOpen = !list.classList.toggle('hidden')
			list.classList.toggle('flex', isOpen)
			button.setAttribute('aria-expanded', String(isOpen))
			button.querySelector('svg').classList.toggle('rotate-180', isOpen)
		})
	})
</script>
