---
import HeaderLink from '@/components/HeaderLink'
import MenuIcon from './icons/MenuIcon.astro'
import Search from '@/components/Search'
import TagIcon from './icons/TagIcon.astro'
import ToggleTheme from './ToggleTheme.astro'
import { SOCIALNETWORKS } from '@/data/links'
---

<header
	class='fixed top-0 left-0 right-0 bg-gray-100 dark:bg-ink/80 backdrop-blur-xl rounded-b-xl shadow-md dark:rounded-none dark:shadow-none border-b border-transparent dark:border-ink-line z-50'
>
	<div class='max-w-7xl mx-auto flex items-center justify-between h-20 px-4 md:px-8'>
		<!-- LEFT: Logo + Title -->
		<div class='flex items-center gap-4'>
			{
				/* Pas d'image de logo : /images/logo.png a été retiré et l'ancienne balise
				    affichait un 404 (l'alt se superposait au titre). Le mot-symbole suffit. */
			}
			{
				/* Le sous-titre est réservé à partir de 1024 px : en dessous, la place
				    manque (titre + loupe + thème + menu d'un côté, nav de l'autre) et il
				    se replie sur deux lignes au lieu de tenir sur une seule. */
			}
			<div class='flex flex-col'>
				<span class='text-3xl font-bold text-primary'><a href='/'>Terres Sucrées</a></span>
				<span class='hidden lg:inline text-sm text-gray-500 dark:text-ink-muted ml-1'>
					Recettes de pâtisserie végétale
				</span>
			</div>
		</div>

		<!-- CENTER: Main Navigation -->
		{
			/* Trois entrées en 768 px (logo + titre à gauche, contrôles à droite) : le
			    resserrage gap-3 évite que la nav ne touche la loupe. */
		}
		<nav class='hidden md:flex items-center gap-3 lg:gap-6 whitespace-nowrap'>
			<div class='relative group'>
				<button
					class='flex items-center gap-1 font-medium text-base lg:text-lg focus:outline-none cursor-pointer'
				>
					Créations
					<svg
						class='w-4 h-4 transition-transform group-hover:rotate-180'
						fill='none'
						stroke='currentColor'
						viewBox='0 0 24 24'
					>
						<path stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M19 9l-7 7-7-7'
						></path>
					</svg>
				</button>
				<ul
					class='absolute invisible opacity-0 group-hover:visible group-hover:opacity-100 transition-all duration-200 bg-white dark:bg-ink-surface rounded-md shadow-lg dark:border dark:border-ink-line dark:shadow-none mt-2 py-2 min-w-[180px] z-50'
				>
					<li>
						<a
							href='/tags/entremets/'
							class='block px-4 py-2 hover:bg-gray-100 dark:hover:bg-ink-raised'>Entremets</a
						>
					</li>
					<li>
						<a
							href='/tags/tartes/'
							class='block px-4 py-2 hover:bg-gray-100 dark:hover:bg-ink-raised'>Tartes</a
						>
					</li>
					<li>
						<a
							href='/tags/gâteaux-de-voyage/'
							class='block px-4 py-2 hover:bg-gray-100 dark:hover:bg-ink-raised'
							>Gâteaux de voyage</a
						>
					</li>
					<li>
						<a
							href='/tags/chocolat/'
							class='block px-4 py-2 hover:bg-gray-100 dark:hover:bg-ink-raised'>Chocolat</a
						>
					</li>
				</ul>
			</div>
			<div class='relative group'>
				<button
					class='flex items-center gap-1 font-medium text-base lg:text-lg focus:outline-none cursor-pointer'
				>
					Compositions
					<svg
						class='w-4 h-4 transition-transform group-hover:rotate-180'
						fill='none'
						stroke='currentColor'
						viewBox='0 0 24 24'
					>
						<path stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M19 9l-7 7-7-7'
						></path>
					</svg>
				</button>
				<ul
					class='absolute invisible opacity-0 group-hover:visible group-hover:opacity-100 transition-all duration-200 bg-white dark:bg-ink-surface rounded-md shadow-lg dark:border dark:border-ink-line dark:shadow-none mt-2 py-2 min-w-[180px] z-50'
				>
					<li>
						<a
							href='/ingredients/'
							class='block px-4 py-2 hover:bg-gray-100 dark:hover:bg-ink-raised'>Préparations</a
						>
					</li>
					<li>
						<a
							href='/creer-ma-recette/'
							class='block px-4 py-2 hover:bg-gray-100 dark:hover:bg-ink-raised'>Créer ma recette</a
						>
					</li>
				</ul>
			</div>

			<a
				href='/about/'
				class='font-medium text-base lg:text-lg hover:text-primary transition-colors'
			>
				À propos
			</a>
		</nav>

		<!-- RIGHT: Search / Social / Theme / Mobile Menu -->
		<div class='flex items-center gap-3'>
			<Search />
			<ToggleTheme />
			<div class='hidden md:flex gap-3'>
				{
					SOCIALNETWORKS.map((network) => (
						<HeaderLink href={network.url} target='_blank' aria-label={network.name}>
							<network.icon />
						</HeaderLink>
					))
				}
			</div>
			<button id='astro-header-drawer-button' type='button' class='md:hidden'>
				<MenuIcon />
				<span class='sr-only'>Menu</span>
			</button>
		</div>
	</div>
</header>

<!-- MOBILE DRAWER -->
<div
	id='astro-header-drawer'
	class='fixed top-0 right-0 w-64 h-full bg-white dark:bg-ink-surface dark:border-l dark:border-ink-line transform translate-x-full transition-transform duration-300 z-50 md:hidden p-6'
>
	<nav class='flex flex-col gap-4'>
		<div class='flex flex-col gap-3' data-drawer-group>
			<button
				id='astro-header-drawer-creations'
				type='button'
				class='flex items-center justify-between w-full text-left'
				aria-expanded='false'
				aria-controls='astro-header-drawer-creations-list'
				data-drawer-toggle
			>
				Créations
				<svg
					class='w-4 h-4 transition-transform'
					fill='none'
					stroke='currentColor'
					viewBox='0 0 24 24'
				>
					<path stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M19 9l-7 7-7-7'
					></path>
				</svg>
			</button>
			<div
				id='astro-header-drawer-creations-list'
				class='hidden flex-col gap-3 pl-4'
				data-drawer-list
			>
				<HeaderLink href='/tags/entremets/'>Entremets</HeaderLink>
				<HeaderLink href='/tags/tartes/'>Tartes</HeaderLink>
				<HeaderLink href='/tags/gâteaux-de-voyage/'>Gâteaux de voyage</HeaderLink>
				<HeaderLink href='/tags/chocolat/'>Chocolat</HeaderLink>
				<HeaderLink href='/tags/'>Autres</HeaderLink>
			</div>
		</div>
		<div class='flex flex-col gap-3' data-drawer-group>
			<button
				id='astro-header-drawer-compositions'
				type='button'
				class='flex items-center justify-between w-full text-left'
				aria-expanded='false'
				aria-controls='astro-header-drawer-compositions-list'
				data-drawer-toggle
			>
				Compositions
				<svg
					class='w-4 h-4 transition-transform'
					fill='none'
					stroke='currentColor'
					viewBox='0 0 24 24'
				>
					<path stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M19 9l-7 7-7-7'
					></path>
				</svg>
			</button>
			<div
				id='astro-header-drawer-compositions-list'
				class='hidden flex-col gap-3 pl-4'
				data-drawer-list
			>
				<HeaderLink href='/ingredients/'>Préparations</HeaderLink>
				<HeaderLink href='/creer-ma-recette/'>Créer ma recette</HeaderLink>
			</div>
		</div>
		<div class='flex gap-3 mt-4'>
			{
				SOCIALNETWORKS.map((network) => (
					<HeaderLink href={network.url} target='_blank' aria-label={network.name}>
						<network.icon />
					</HeaderLink>
				))
			}
		</div>
	</nav>
</div>

<script>
	// Drawer toggle
	const menu = document.getElementById('astro-header-drawer')
	const menuButton = document.getElementById('astro-header-drawer-button')

	menuButton.addEventListener('click', (e) => {
		menu.classList.toggle('translate-x-full')
		e.stopPropagation()
	})

	document.addEventListener('click', (e) => {
		if (!menu.contains(e.target) && !menuButton.contains(e.target)) {
			menu.classList.add('translate-x-full')
		}
	})

	// Sous-menus du tiroir : « Créations » et « Compositions »
	document.querySelectorAll('[data-drawer-group]').forEach((group) => {
		const button = group.querySelector('[data-drawer-toggle]')
		const list = group.querySelector('[data-drawer-list]')

		button.addEventListener('click', (e) => {
			e.stopPropagation()
			const isOpen = !list.classList.toggle('hidden')
			list.classList.toggle('flex', isOpen)
			button.setAttribute('aria-expanded', String(isOpen))
			button.querySelector('svg').classList.toggle('rotate-180', isOpen)
		})
	})
</script>
