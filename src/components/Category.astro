---
import { cn, sluglify } from '@/utils'

const { name = 'Tout afficher', activeCategory } = Astro.props
const currentPath = Astro.url.pathname
const unsluglifyNameCategory = sluglify(name.toLowerCase())

const isActive =
	activeCategory?.toLocaleLowerCase() === unsluglifyNameCategory ||
	((currentPath === '/' || currentPath.startsWith('/all/')) && name === 'Tout afficher')
---

<a
	href={name === 'Tout afficher' ? '/all/1' : sluglify(`/category/${unsluglifyNameCategory}/1`)}
	class={cn(
		`text-gray-600 dark:text-ink-body  pb-2.5 first-letter:uppercase font-medium hover:text-gray-800 border-b-2 border-opacity-0 dark:border-opacity-0 border-black dark:border-ink-text dark:hover:border-ink-text hover:border-opacity-100 transition-colors duration-150 ease-linear  `,
		isActive &&
			`border-black border-b-2 text-black z-10  dark:border-ink-text dark:text-ink-text dark:border-opacity-100 border-opacity-100`
	)}
>
	{name}
</a>
