---
import { cn, sluglify } from '@/utils'
import { SEASON_STYLES } from '@/data/categories'

const { name = 'Tout afficher', activeCategory } = Astro.props
const currentPath = Astro.url.pathname
const unsluglifyNameCategory = sluglify(name.toLowerCase())

const isActive =
	activeCategory?.toLocaleLowerCase() === unsluglifyNameCategory ||
	((currentPath === '/' || currentPath.startsWith('/all/')) && name === 'Tout afficher')

// Les saisons affichent une puce de leur couleur : le filtre reprend ainsi la
// teinte des pastilles portées par les cartes de recettes.
const season = SEASON_STYLES[name.trim().toLowerCase()]

// Les URL canoniques du site se terminent par « / » : les liens internes
// doivent pointer vers cette forme pour éviter des doublons d'URL.
const href =
	name === 'Tout afficher' ? '/all/1/' : sluglify(`/category/${unsluglifyNameCategory}/1/`)
---

<a
	href={href}
	class={cn(
		'pop-chip !rounded-full !px-4 !py-1.5 !text-[0.78rem] !normal-case hover:-translate-y-0.5',
		isActive && 'pop-chip--grape'
	)}
>
	{
		season && (
			<span
				class={cn('h-2 w-2 shrink-0 rounded-full border border-outline/70', season.dot)}
				aria-hidden='true'
			/>
		)
	}
	{name}
</a>
