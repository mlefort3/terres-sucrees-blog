---
// Flèche « ouvrir la fiche » : diagonale vers le haut-droite, en trait (feather).
//
// `class` est acceptée pour laisser l'appelant animer la flèche seule (voir la
// pastille du catalogue des préparations) sans dupliquer le dessin.
export interface Props {
	width?: number | string
	height?: number | string
	class?: string
}

const { width = 24, height = 24, class: className } = Astro.props
---

<svg
	class:list={['feather feather-arrow-up-right', className]}
	fill='none'
	height={height}
	stroke='currentColor'
	stroke-linecap='round'
	stroke-linejoin='round'
	stroke-width='2.5'
	viewBox='0 0 24 24'
	width={width}
	xmlns='http://www.w3.org/2000/svg'
	><line x1='7' x2='17' y1='17' y2='7'></line><polyline points='7 7 17 7 17 17'></polyline></svg
>
