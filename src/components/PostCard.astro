---
import { Image } from 'astro:assets'
import FormattedDate from '@/components/FormattedDate'
import ArrowUp from '@/components/icons/ArrowUp'
import { seasonChipClass } from '@/data/categories'

const {
	id,
	data: { title, description, pubDate, heroImage, categories },
	readTime,
	slug,
	// La première carte de l'accueil occupe deux colonnes : son visuel passe
	// alors sur un cadrage plus panoramique pour ne pas étirer la rangée.
	big = false
} = Astro.props
---

<article class='pop-card group flex min-h-full flex-col overflow-hidden'>
	{
		(
			/*
		Le visuel occupe toute la hauteur restante de la carte : dans une rangée où
		une carte est plus haute (la première de l'accueil, par exemple), la photo
		s'étire au lieu de laisser un grand vide blanc sous le texte.
	*/ <>
				<a
					class='relative block min-h-[240px] flex-1 overflow-hidden border-b-2 border-outline dark:border-ink-line'
					href={`/post/${slug}/`}
				>
					<Image
						src={heroImage}
						width={900}
						height={560}
						format='webp'
						class='absolute inset-0 h-full w-full object-cover transition-transform duration-300 ease-out group-hover:scale-[1.03]'
						alt={`Photo de la recette : ${title}`}
					/>

					{categories && Array.isArray(categories) && categories.length > 0 && (
						<div class='absolute left-3 top-3 flex flex-wrap gap-2'>
							{categories.map((category: string) => (
								<span class={`pop-chip ${seasonChipClass(category)}`}>{category}</span>
							))}
						</div>
					)}
				</a>
				<div class='flex flex-1 flex-col gap-3 p-6'>
					<div class='flex flex-wrap items-center gap-x-2.5 gap-y-1 text-[11px] font-bold uppercase tracking-[0.14em] text-ink/50 dark:text-ink-faint'>
						<FormattedDate date={pubDate} />
						<span aria-hidden='true' class='text-primary_second dark:text-primary_second'>
							•
						</span>
						<span>{readTime.replace('read', 'de lecture')}</span>
					</div>

					<h2
						class={
							big
								? 'font-display text-[26px] leading-[1.08] text-ink dark:text-ink-text md:text-[34px]'
								: 'font-display text-[26px] leading-[1.08] text-ink dark:text-ink-text'
						}
					>
						<a
							href={`/post/${slug}/`}
							class='transition-colors hover:text-primary dark:hover:text-primary_second'
						>
							{title}
						</a>
					</h2>

					<p class='line-clamp-3 text-[15px] leading-relaxed text-ink/70 dark:text-ink-body'>
						{description}
					</p>

					<footer class='mt-auto pt-3'>
						<a
							href={`/post/${slug}/`}
							class='pop-btn pop-btn--paper pop-btn--sm gap-1.5'
							aria-label={`Lire la recette ${title}`}
						>
							Lire la recette
							<span class='transition-transform duration-200 ease-out group-hover:rotate-45'>
								<ArrowUp width='15' height='15' />
							</span>
						</a>
					</footer>
				</div>
			</>
		)
	}
</article>
