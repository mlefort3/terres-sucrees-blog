---
import { siteConfig } from '@/site-config'
import '../styles/global.css'
import { ViewTransitions } from 'astro:transitions'

export interface Props {
	title: string
	description?: string
	ogImage?: string | undefined
	articleDate?: string | undefined
	noindex?: boolean
	/** Force la balise canonical (ex. /all/1 doit pointer vers /). */
	canonical?: string | undefined
	/**
	 * N'émet aucune balise canonical. Réservé à la page 404 : un canonical doit
	 * désigner une URL réelle et indexable, or /404/ n'existe pas.
	 */
	noCanonical?: boolean
}

const {
	title,
	description = siteConfig.description,
	ogImage,
	articleDate,
	noindex = false,
	canonical,
	noCanonical = false
} = Astro.props
const pageURL = new URL(Astro.url.pathname, Astro.site).href
const canonicalURL = canonical ?? pageURL
const socialImageURL = new URL(ogImage ? ogImage : '/open-graph.png', Astro.url).href

// Le nom du site est ajouté à la balise <title> : « Recette • Terres Sucrées ».
const capitalizedTitle = `${title}`.charAt(0).toUpperCase() + `${title}`.slice(1)
const siteTitle = capitalizedTitle.includes(siteConfig.author)
	? capitalizedTitle
	: `${capitalizedTitle} | ${siteConfig.author}`

import { join } from 'path'
import { AstroFont } from 'astro-font'
---

<!-- Global Metadata -->
<meta charset='utf-8' />
<meta name='viewport' content='width=device-width,initial-scale=1' />
<link rel='apple-touch-icon' sizes='180x180' href='/apple-touch-icon.png' />
<link rel='icon' type='image/png' sizes='32x32' href='/favicon-32x32.png' />
<link rel='icon' type='image/png' sizes='16x16' href='/favicon-16x16.png' />
<link rel='manifest' href='/site.webmanifest' />
<meta name='generator' content={Astro.generator} />

<!-- Canonical URL -->
{!noCanonical && <link rel='canonical' href={canonicalURL} />}

<!-- Robots Meta -->
{
	noindex ? (
		<meta name='robots' content='noindex, follow' />
	) : (
		<meta
			name='robots'
			content='index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'
		/>
	)
}

<!-- Primary Meta Tags -->
<title>{siteTitle}</title>

<!-- ViewTransitions  -->
<!-- <ViewTransitions /> -->

<!-- SEO -->
<meta name='title' content={siteTitle} />
<meta name='description' content={description} />
<meta name='author' content={siteConfig.author} />

<!-- Open Graph / Facebook -->
<meta property='og:type' content={articleDate ? 'article' : 'website'} />
<meta property='og:url' content={canonicalURL} />
<meta property='og:locale' content={siteConfig.ogLocale} />
<meta property='og:site_name' content={siteConfig.author} />
<meta property='og:title' content={title} />
<meta property='og:description' content={description} />
<meta property='og:image' content={socialImageURL} />
<meta property='og:image:alt' content={title} />
{
	articleDate && (
		<>
			<meta property='article:author' content={siteConfig.author} />
			<meta property='article:published_time' content={articleDate} />
		</>
	)
}

<!-- Twitter -->
<meta property='twitter:card' content='summary_large_image' />
<meta property='twitter:url' content={canonicalURL} />
<meta property='twitter:title' content={title} />
<meta property='twitter:description' content={description} />
<meta property='twitter:image' content={socialImageURL} />
<meta property='twitter:image:alt' content={title} />

<!-- RSS auto-discovery -->
<link rel='alternate' type='application/rss+xml' title={siteConfig.title} href='/rss.xml' />

<AstroFont
	config={[
		{
			preload: true,
			display: 'swap',
			name: 'Outfit',
			fallback: 'sans-serif',
			src: [
				{
					weight: '100',
					style: 'normal',
					path: join(process.cwd(), 'public', 'fonts', 'Outfit-ExtraLight.ttf')
				},
				{
					weight: '200',
					style: 'normal',
					path: join(process.cwd(), 'public', 'fonts', 'Outfit-Light.ttf')
				},
				{
					// `Outfit-LightMedium.ttf` n'existe pas dans `public/fonts` : la face
					// 300 était donc absente et chaque page déclenchait un 404.
					weight: '300',
					style: 'normal',
					path: join(process.cwd(), 'public', 'fonts', 'Outfit-Light.ttf')
				},
				{
					weight: '400',
					style: 'normal',
					path: join(process.cwd(), 'public', 'fonts', 'Outfit-Regular.ttf')
				},
				{
					weight: '500',
					style: 'normal',
					path: join(process.cwd(), 'public', 'fonts', 'Outfit-Medium.ttf')
				},
				{
					weight: '600',
					style: 'normal',
					path: join(process.cwd(), 'public', 'fonts', 'Outfit-SemiBold.ttf')
				},
				{
					weight: '700',
					style: 'normal',
					path: join(process.cwd(), 'public', 'fonts', 'Outfit-Bold.ttf')
				},
				{
					weight: '800',
					style: 'normal',
					path: join(process.cwd(), 'public', 'fonts', 'Outfit-ExtraBold.ttf')
				},
				{
					weight: '900',
					style: 'normal',
					path: join(process.cwd(), 'public', 'fonts', 'Outfit-Black.ttf')
				}
			]
		}
	]}
/>
