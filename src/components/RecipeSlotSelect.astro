---
interface Props {
	kind: string
	slot: { key: string; label: string; hint: string; required: boolean }
	options: { id: string; name: string }[]
	/** Marks a non-required slot that sits in the main grid rather than in the optional panel. */
	showOptionalBadge?: boolean
	/**
	 * Identifiant du champ caché, quand la page le lit déjà par son id (le type de
	 * recette de « Créer ma recette »). Sans valeur, l'id est dérivé de `kind` et
	 * `slot.key` comme pour les autres menus.
	 */
	hiddenId?: string
	/** Invite du champ texte : « Rechercher… » par défaut, à adapter au contexte. */
	placeholder?: string
}

const {
	kind,
	slot,
	options,
	showOptionalBadge = false,
	hiddenId,
	placeholder = 'Rechercher…'
} = Astro.props

// Menu déroulant avec recherche : le champ texte filtre sa propre liste, la
// valeur retenue reste portée par un <input type=hidden data-slot> — c'est lui
// que lit le script de la page (`.value` + événement `change`).
//
// La liste vit hors du <label> : un clic sur une option serait sinon rejoué sur
// le champ par l'activation du label, et la liste se rouvrirait aussitôt.
const labelId = `${kind}-${slot.key}-label`
const hintId = `${kind}-${slot.key}-hint`
const listId = `${kind}-${slot.key}-list`
const optionId = (index: number) => `${kind}-${slot.key}-option-${index}`
const fieldClass = 'pop-field pr-9'
const optionClass =
	'cursor-pointer px-3 py-2 text-sm text-ink dark:text-ink-text hover:bg-butter dark:hover:bg-ink-raised'
// Le badge « Recommandé » est masqué par défaut : le script de la page le révèle
// sur les options dont une saveur est recommandée avec la couche déjà choisie.
const recommendedBadgeClass =
	'shrink-0 rounded border-2 border-outline bg-mint px-1.5 py-0.5 text-[9px] font-bold uppercase tracking-[0.08em] text-outline'
---

<div class='flex flex-col gap-2'>
	<span class='flex flex-wrap items-baseline gap-2'>
		<span
			id={labelId}
			class='text-[11px] font-bold uppercase tracking-[0.16em] text-ink/60 dark:text-ink-faint'
		>
			{slot.label}
		</span>
		{
			showOptionalBadge && !slot.required && (
				<span class='rounded border border-ink/25 px-1.5 py-0.5 text-[9px] font-bold uppercase tracking-[0.1em] text-ink/50 dark:border-ink-line dark:text-ink-muted'>
					Facultatif
				</span>
			)
		}
	</span>
	<div class='relative' data-combobox>
		<input type='hidden' id={hiddenId} data-slot={slot.key} value='' />
		<input
			id={`${kind}-${slot.key}`}
			type='text'
			role='combobox'
			autocomplete='off'
			spellcheck='false'
			placeholder={placeholder}
			aria-expanded='false'
			aria-controls={listId}
			aria-autocomplete='list'
			aria-labelledby={labelId}
			aria-describedby={hintId}
			data-combobox-input
			class={fieldClass}
		/>
		<svg
			data-combobox-chevron
			class='pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 w-4 h-4 text-ink/40 dark:text-ink-muted transition-transform'
			fill='none'
			stroke='currentColor'
			viewBox='0 0 24 24'
		>
			<path stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M19 9l-7 7-7-7'
			></path>
		</svg>
		<ul
			id={listId}
			role='listbox'
			hidden
			class='absolute left-0 right-0 z-30 mt-1 max-h-60 overflow-auto rounded-xl border-2 border-outline bg-white py-1 shadow-[4px_4px_0_0_#241e38] dark:border-ink-line dark:bg-ink-surface dark:shadow-[4px_4px_0_0_rgba(189,183,253,0.18)]'
		>
			<li
				id={optionId(0)}
				role='option'
				aria-selected='false'
				data-value=''
				data-label='Pas de sélection'
				class='cursor-pointer px-3 py-2 text-sm italic text-ink/45 dark:text-ink-muted hover:bg-butter dark:hover:bg-ink-raised'
			>
				Pas de sélection
			</li>
			{
				options.map((option, index) => (
					<li
						id={optionId(index + 1)}
						role='option'
						aria-selected='false'
						data-value={option.id}
						data-label={option.name}
						class={`${optionClass} flex items-center justify-between gap-2`}
					>
						<span>{option.name}</span>
						<span data-rec-badge hidden class={recommendedBadgeClass}>
							Recommandé
						</span>
					</li>
				))
			}
		</ul>
		<div
			data-combobox-empty
			hidden
			class='absolute left-0 right-0 z-30 mt-1 rounded-xl border-2 border-outline bg-white px-3 py-2 text-sm font-semibold text-ink shadow-[4px_4px_0_0_#241e38] dark:border-ink-line dark:bg-ink-surface dark:text-ink-muted'
		>
			Aucun résultat
		</div>
	</div>
	<span id={hintId} class='text-xs text-ink/50 dark:text-ink-faint'>{slot.hint}</span>
</div>
