---
interface Props {
	kind: string
	slot: { key: string; label: string; hint: string; required: boolean }
	options: { id: string; name: string }[]
	/** Marks a non-required slot that sits in the main grid rather than in the optional panel. */
	showOptionalBadge?: boolean
}

const { kind, slot, options, showOptionalBadge = false } = Astro.props
---

<label class='flex flex-col gap-2'>
	<span class='flex flex-wrap items-baseline gap-2'>
		<span class='font-semibold text-primary'>{slot.label}</span>
		{
			showOptionalBadge && !slot.required && (
				<span class='text-[10px] uppercase tracking-wide text-slate-500 dark:text-slate-400 border border-slate-300 dark:border-slate-700 rounded px-1.5 py-0.5'>
					Facultatif
				</span>
			)
		}
	</span>
	<div class='relative'>
		<select
			id={`${kind}-${slot.key}`}
			data-slot={slot.key}
			class='w-full appearance-none rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900 text-slate-900 dark:text-slate-100 px-3 py-2 pr-9 text-base focus:outline-none focus:ring-2 focus:ring-primary'
		>
			<option value=''>Pas de sélection</option>
			{options.map((option) => <option value={option.id}>{option.name}</option>)}
		</select>
		<svg
			class='pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 w-4 h-4 text-slate-500 dark:text-slate-400'
			fill='none'
			stroke='currentColor'
			viewBox='0 0 24 24'
		>
			<path stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M19 9l-7 7-7-7'
			></path>
		</svg>
	</div>
	<span class='text-xs text-slate-500 dark:text-slate-500'>{slot.hint}</span>
</label>
