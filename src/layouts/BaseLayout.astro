---
import BaseHead from '@/components/BaseHead'
import Header from '@/components/Header'
import Footer from '@/components/Footer'
import ProviderTheme from '@/components/ProviderTheme'
import ProviderAnimations from '@/components/ProviderAnimations'
import TwSizeIndicator from '@/components/TwSizeIndicator'
import EditBlog from '@/components/editBlog'
import { siteConfig } from '@/site-config'
const {
	title,
	description,
	image,
	articleDate,
	noindex = false,
	canonical,
	gradient = false
} = Astro.props
---

<html lang={siteConfig.lang} class='scroll-smooth'>
	<head>
		<BaseHead
			title={title}
			description={description}
			ogImage={image}
			articleDate={articleDate}
			noindex={noindex}
			canonical={canonical}
		/>
		<script is:inline>
			const s = document.createElement('script')
			s.src = 'https://app.rybbit.io/api/script.js'
			s.dataset.siteId = '62a2dd88e8a6'
			document.head.appendChild(s)
		</script>

		<script is:inline>
			;(function () {
				const s = document.createElement('script')
				s.src = 'https://goatcounter-terres-sucrees.onrender.com/count.js'
				s.async = true
				s.setAttribute('data-goatcounter', 'https://goatcounter-terres-sucrees.onrender.com/count')
				document.head.appendChild(s)
			})()
		</script>
		<ProviderTheme />
		<ProviderAnimations />
	</head>

	<body
		class:list={[
			'bg-white text-stone-950 dark:bg-ink dark:text-ink-text',
			gradient && 'gradient-page'
		]}
	>
		<main
			class='px-5 sm:mx-auto sm:max-w-2xl sm:px-8 lg:px-0 antialiased md:max-w-6xl grid gap-12 mt-32 overflow-hidden md:overflow-visible'
		>
			<Header />
			<slot />
			<Footer />
		</main>
		<TwSizeIndicator />
		<EditBlog />
		<style>
			body {
				margin-left: calc(100vw - 100%); /* prevent layout shift */
			}
		</style>
	</body>
</html>
