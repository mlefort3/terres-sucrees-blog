---
import BaseHead from '@/components/BaseHead'
import Header from '@/components/Header'
import Footer from '@/components/Footer'
import ProviderTheme from '@/components/ProviderTheme'
import ProviderAnimations from '@/components/ProviderAnimations'
import TwSizeIndicator from '@/components/TwSizeIndicator'
import EditBlog from '@/components/editBlog'
import { siteConfig } from '@/site-config'
const {
	title,
	description,
	image,
	articleDate,
	noindex = false,
	canonical,
	noCanonical = false,
	gradient = false
} = Astro.props
---

<html lang={siteConfig.lang} class='scroll-smooth'>
	<head>
		<BaseHead
			title={title}
			description={description}
			ogImage={image}
			articleDate={articleDate}
			noindex={noindex}
			canonical={canonical}
			noCanonical={noCanonical}
		/>
		<script is:inline>
			const s = document.createElement('script')
			s.src = 'https://app.rybbit.io/api/script.js'
			s.dataset.siteId = '62a2dd88e8a6'
			document.head.appendChild(s)
		</script>

		<script is:inline>
			;(function () {
				const s = document.createElement('script')
				s.src = 'https://goatcounter-terres-sucrees.onrender.com/count.js'
				s.async = true
				s.setAttribute('data-goatcounter', 'https://goatcounter-terres-sucrees.onrender.com/count')
				document.head.appendChild(s)
			})()
		</script>
		<ProviderTheme />
		<ProviderAnimations />
	</head>

	<body class:list={['font-body text-ink dark:text-ink-text', gradient && 'gradient-page']}>
		<!-- Sur mobile, la grille est rognée horizontalement pour que les cartes
		     inclinées ne créent pas de défilement latéral. On rogne donc l'axe X
		     seul : un `overflow-hidden` complet coupait le haut des pastilles qui
		     chevauchent le bord supérieur de la première carte (accueil).
		     À partir de `md`, le conteneur est centré et laisse tout déborder. -->
		<main
			class='px-5 pb-16 sm:mx-auto sm:max-w-2xl sm:px-8 lg:px-0 antialiased md:max-w-6xl grid gap-12 mt-28 md:mt-36 overflow-x-clip md:overflow-visible'
		>
			<Header />
			<slot />
			<Footer />
		</main>
		<TwSizeIndicator />
		<EditBlog />
	</body>
</html>
